<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="580.0" prefWidth="640.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="FastRailStation.view.controller.DettagliTrenoAdminController">

    <!-- ══ TOP BAR ══ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-background-color: #9597a0; -fx-border-color: #800303; -fx-border-width: 0 0 2 0; -fx-padding: 14 22 14 22;" BorderPane.alignment="CENTER">
            <Label fx:id="orologio" styleClass="timeLabel" text="00:00:00" />
            <HBox HBox.hgrow="ALWAYS" />
            <Pane prefHeight="20.0" prefWidth="3.0" style="-fx-background-color: #800303; -fx-background-radius: 2;" />
            <Label style="-fx-font-size: 20px;" styleClass="titleLabel" text="Modifica Treno" />
        </HBox>
    </top>

    <!-- ══ CENTER ══ -->
    <center>
        <VBox spacing="0.0" style="-fx-background-color: #9597a0;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="22.0" left="22.0" right="22.0" top="22.0" /></padding>

            <!-- Section label -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <VBox.margin><Insets bottom="14.0" /></VBox.margin>
                <Pane prefHeight="18.0" prefWidth="3.0" style="-fx-background-color: #800303; -fx-background-radius: 2;" />
                <Label styleClass="section-title" text="DATI TRENO" />
            </HBox>

            <!-- ── Data grid ── -->
            <VBox spacing="0.0" styleClass="content-card">
                <VBox.margin><Insets bottom="16.0" /></VBox.margin>
                <padding><Insets bottom="16.0" left="18.0" right="18.0" top="16.0" /></padding>

                <GridPane hgap="16.0" vgap="8.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="10.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="110.0" prefWidth="118.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="110.0" prefWidth="128.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="20.0" prefWidth="20.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="110.0" prefWidth="118.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="110.0" prefWidth="128.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="10.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints prefHeight="38.0" />
                        <RowConstraints prefHeight="38.0" />
                        <RowConstraints prefHeight="38.0" />
                        <RowConstraints prefHeight="38.0" />
                        <RowConstraints prefHeight="38.0" />
                        <RowConstraints prefHeight="38.0" />
                        <RowConstraints prefHeight="38.0" />
                        <RowConstraints prefHeight="38.0" />
                        <RowConstraints prefHeight="38.0" />
                        <RowConstraints prefHeight="38.0" />
                    </rowConstraints>
                    <children>
                        <!-- LEFT labels -->
                        <Label styleClass="info-key" text="Modello" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label styleClass="info-key" text="Provenienza" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label styleClass="info-key" text="Destinazione" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label styleClass="info-key" text="Deposito" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <Label styleClass="info-key" text="Binario" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                        <Label styleClass="info-key" text="Compagnia" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                        <Label styleClass="info-key" text="Posti totali" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                        <Label styleClass="info-key" text="Posti occupati" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                        <Label styleClass="info-key" text="Stato" GridPane.columnIndex="1" GridPane.rowIndex="8" />
                        <Label styleClass="info-key" text="Intervallo giorni" GridPane.columnIndex="1" GridPane.rowIndex="9" />

                        <!-- RIGHT labels -->
                        <Label styleClass="info-key" text="Giorno arrivo" GridPane.columnIndex="4" GridPane.rowIndex="0" />
                        <Label styleClass="info-key" text="Giorno partenza" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                        <Label styleClass="info-key" text="Ora partenza" GridPane.columnIndex="4" GridPane.rowIndex="2" />
                        <Label styleClass="info-key" text="Ora arrivo" GridPane.columnIndex="4" GridPane.rowIndex="3" />
                        <Label styleClass="info-key" text="Ritardo (min)" GridPane.columnIndex="4" GridPane.rowIndex="4" />
                        <Label styleClass="info-key" text="Inizio manutenzione" GridPane.columnIndex="4" GridPane.rowIndex="5" />
                        <Label styleClass="info-key" text="Fine manutenzione" GridPane.columnIndex="4" GridPane.rowIndex="6" />
                        <Label styleClass="info-key" text="Deposito manut." GridPane.columnIndex="4" GridPane.rowIndex="7" />
                        <Label styleClass="info-key" text="Codice treno" GridPane.columnIndex="4" GridPane.rowIndex="8" />

                        <!-- LEFT inputs -->
                        <ComboBox fx:id="modelloTrenoCmbx" prefWidth="128.0" styleClass="combo-box-ModAereo" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <GridPane.margin><Insets bottom="4.0" top="4.0" /></GridPane.margin>
                        </ComboBox>
                        <TextField fx:id="provenienzaTxF" styleClass="text-field-ModAero" GridPane.columnIndex="2" GridPane.rowIndex="1"><GridPane.margin><Insets bottom="4.0" top="4.0" /></GridPane.margin></TextField>
                        <TextField fx:id="destinazioneTxF" styleClass="text-field-ModAero" GridPane.columnIndex="2" GridPane.rowIndex="2"><GridPane.margin><Insets bottom="4.0" top="4.0" /></GridPane.margin></TextField>
                        <ComboBox fx:id="depositoCmbx" prefWidth="128.0" styleClass="combo-box-ModAereo" GridPane.columnIndex="2" GridPane.rowIndex="3"><GridPane.margin><Insets bottom="4.0" top="4.0" /></GridPane.margin></ComboBox>
                        <TextField fx:id="binarioTxF" styleClass="text-field-ModAero" GridPane.columnIndex="2" GridPane.rowIndex="4"><GridPane.margin><Insets bottom="4.0" top="4.0" /></GridPane.margin></TextField>
                        <TextField fx:id="compagniaTxF" styleClass="text-field-ModAero" GridPane.columnIndex="2" GridPane.rowIndex="5"><GridPane.margin><Insets bottom="4.0" top="4.0" /></GridPane.margin></TextField>
                        <TextField fx:id="postiTotaliTxF" styleClass="text-field-ModAero" GridPane.columnIndex="2" GridPane.rowIndex="6"><GridPane.margin><Insets bottom="4.0" top="4.0" /></GridPane.margin></TextField>
                        <TextField fx:id="postiOccupatiTxF" styleClass="text-field-ModAero" GridPane.columnIndex="2" GridPane.rowIndex="7"><GridPane.margin><Insets bottom="4.0" top="4.0" /></GridPane.margin></TextField>
                        <ComboBox fx:id="statoCmbx" prefWidth="128.0" styleClass="combo-box-ModAereo" GridPane.columnIndex="2" GridPane.rowIndex="8"><GridPane.margin><Insets bottom="4.0" top="4.0" /></GridPane.margin></ComboBox>
                        <TextField fx:id="intervalloTxF" styleClass="text-field-ModAero" GridPane.columnIndex="2" GridPane.rowIndex="9"><GridPane.margin><Insets bottom="4.0" top="4.0" /></GridPane.margin></TextField>

                        <!-- RIGHT inputs -->
                        <DatePicker fx:id="giornoArrivoDp" styleClass="date-picker-ModAero" GridPane.columnIndex="5" GridPane.rowIndex="0"><GridPane.margin><Insets bottom="4.0" top="4.0" /></GridPane.margin></DatePicker>
                        <DatePicker fx:id="giornoPartenzaDp" styleClass="date-picker-ModAero" GridPane.columnIndex="5" GridPane.rowIndex="1"><GridPane.margin><Insets bottom="4.0" top="4.0" /></GridPane.margin></DatePicker>
                        <TextField fx:id="orarioPartenzaTxF" styleClass="text-field-ModAero" GridPane.columnIndex="5" GridPane.rowIndex="2"><GridPane.margin><Insets bottom="4.0" top="4.0" /></GridPane.margin></TextField>
                        <TextField fx:id="orarioArrivoTxF" styleClass="text-field-ModAero" GridPane.columnIndex="5" GridPane.rowIndex="3"><GridPane.margin><Insets bottom="4.0" top="4.0" /></GridPane.margin></TextField>
                        <TextField fx:id="ritardoTxF" styleClass="text-field-ModAero" GridPane.columnIndex="5" GridPane.rowIndex="4"><GridPane.margin><Insets bottom="4.0" top="4.0" /></GridPane.margin></TextField>
                        <DatePicker fx:id="inizioLavoriDp" styleClass="date-picker-ModAero" GridPane.columnIndex="5" GridPane.rowIndex="5"><GridPane.margin><Insets bottom="4.0" top="4.0" /></GridPane.margin></DatePicker>
                        <DatePicker fx:id="fineLavoriDp" styleClass="date-picker-ModAero" GridPane.columnIndex="5" GridPane.rowIndex="6"><GridPane.margin><Insets bottom="4.0" top="4.0" /></GridPane.margin></DatePicker>
                        <TextField fx:id="hangarTxf" styleClass="text-field-ModAero" GridPane.columnIndex="5" GridPane.rowIndex="7"><GridPane.margin><Insets bottom="4.0" top="4.0" /></GridPane.margin></TextField>
                        <TextField fx:id="codiceTxF" styleClass="text-field-ModAero" GridPane.columnIndex="5" GridPane.rowIndex="8"><GridPane.margin><Insets bottom="4.0" top="4.0" /></GridPane.margin></TextField>
                    </children>
                </GridPane>
            </VBox>

            <!-- Nome treno row -->
            <HBox alignment="CENTER_LEFT" prefHeight="23.0" prefWidth="612.0" spacing="14.0">
                <VBox.margin><Insets bottom="20.0" /></VBox.margin>
                <Label prefHeight="18.0" prefWidth="115.0" styleClass="info-key" text="Nome treno">
               <padding>
                  <Insets left="30.0" />
               </padding></Label>
                <TextField fx:id="nomeTreno" prefWidth="280.0" styleClass="text-field-ModAero" />
            <padding>
               <Insets top="20.0" />
            </padding>
            </HBox>

            <!-- Action buttons -->
            <HBox alignment="CENTER" spacing="12.0">
                <Button mnemonicParsing="false" onAction="#rimuoviTreno" prefHeight="48.0" prefWidth="180.0" styleClass="cancellaButton" text="❌ Cancella" />
                <Button fx:id="modificaBtn" mnemonicParsing="false" onAction="#modifica" prefHeight="48.0" prefWidth="180.0" styleClass="pagesButtonInternal" text="Modifica" />
                <Button fx:id="salvaBtn" mnemonicParsing="false" onAction="#salva" prefHeight="48.0" prefWidth="180.0" style="-fx-text-fill: #c5c5c5;" styleClass="pagesButtonDx" text="✍ Salva" />
            </HBox>

        </VBox>
    </center>
</BorderPane>

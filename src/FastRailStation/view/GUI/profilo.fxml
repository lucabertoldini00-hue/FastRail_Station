<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="FastRailStation.view.controller.ProfiloController">

    <!-- ══ HEADER NAV ══ -->
    <top>
        <GridPane prefHeight="117.0" prefWidth="1000.0" styleClass="header-nav"
                  BorderPane.alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="30.0"  minWidth="10.0" prefWidth="30.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="350.0" minWidth="10.0" prefWidth="280.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints maxHeight="20.0" minHeight="10.0" prefHeight="18.0" vgrow="SOMETIMES"/>
                <RowConstraints maxHeight="80.0" minHeight="50.0" prefHeight="70.0" vgrow="SOMETIMES"/>
                <RowConstraints maxHeight="30.0" minHeight="10.0" prefHeight="29.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <ImageView fitHeight="60.0" fitWidth="200.0" pickOnBounds="true"
                           preserveRatio="true"
                           GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <image><Image url="@../../immagini/Logo.png"/></image>
                </ImageView>
                <Label fx:id="navHome"     alignment="CENTER" styleClass="nav-item"
                       text="Home"     GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <Label fx:id="navArrivi"   alignment="CENTER" styleClass="nav-item"
                       text="Arrivi"   GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                <Label fx:id="navPartenze" alignment="CENTER" styleClass="nav-item"
                       text="Partenze" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
                <Label fx:id="navPrenota"  alignment="CENTER" styleClass="nav-item"
                       text="Prenota"  GridPane.columnIndex="5" GridPane.rowIndex="1"/>
                <Label fx:id="navProfilo"  alignment="CENTER" styleClass="nav-item, nav-item-active"
                       text="Profilo"  GridPane.columnIndex="6" GridPane.rowIndex="1"/>
            </children>
        </GridPane>
    </top>

    <!-- ══ CONTENT ══ -->
    <center>
        <AnchorPane style="-fx-background-color: #0d1b2a;" BorderPane.alignment="CENTER">
            <VBox alignment="TOP_CENTER" spacing="18.0"
                  AnchorPane.topAnchor="28.0" AnchorPane.bottomAnchor="24.0"
                  AnchorPane.leftAnchor="60.0" AnchorPane.rightAnchor="60.0">

                <!-- Title row -->
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <Pane prefWidth="3.0" prefHeight="26.0"
                          style="-fx-background-color: #800303; -fx-background-radius: 2;"/>
                    <Label text="Il mio profilo"
                           style="-fx-text-fill: #f4e7e7; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnModifica" text="✏  Modifica"
                            onAction="#handleModifica"
                            styleClass="ghost-button"/>
                    <Button fx:id="btnSalva" text="💾  Salva"
                            onAction="#handleSalva" disable="true"
                            styleClass="search-button"/>
                    <Button text="🚪  Logout"
                            onAction="#handleLogout"
                            styleClass="danger-button"/>
                </HBox>

                <Pane prefHeight="1.0"
                      style="-fx-background-color: linear-gradient(to right, #800303, #1e3a5f, transparent);"/>

                <!-- ── Card: Dati personali ── -->
                <VBox styleClass="content-card" spacing="14.0">
                    <padding><Insets top="22.0" bottom="22.0" left="24.0" right="24.0"/></padding>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="DATI PERSONALI" styleClass="section-title"/>
                    </HBox>
                    <Pane prefHeight="1.0"
                          style="-fx-background-color: #1e3a5f;">
                        <VBox.margin><Insets bottom="4.0"/></VBox.margin>
                    </Pane>

                    <GridPane hgap="24.0" vgap="12.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="110.0"/>
                            <ColumnConstraints hgrow="ALWAYS"    minWidth="160.0" prefWidth="260.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="30.0"  prefWidth="40.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="110.0"/>
                            <ColumnConstraints hgrow="ALWAYS"    minWidth="160.0" prefWidth="260.0"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="38.0" prefHeight="38.0"/>
                            <RowConstraints minHeight="38.0" prefHeight="38.0"/>
                            <RowConstraints minHeight="38.0" prefHeight="38.0"/>
                            <RowConstraints minHeight="38.0" prefHeight="38.0"/>
                        </rowConstraints>
                        <children>
                            <Label text="Nome"           styleClass="info-key" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <TextField fx:id="tfNome"     editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label text="E-mail"          styleClass="info-key" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <TextField fx:id="tfMail"     editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <Label text="Data di nascita" styleClass="info-key" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <TextField fx:id="tfNascita"  editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            <Label text="Cellulare"       styleClass="info-key" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <TextField fx:id="tfCellulare" editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                            <Label text="Cognome"  styleClass="info-key" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                            <TextField fx:id="tfCognome"  editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
                            <Label text="Nazione"  styleClass="info-key" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                            <TextField fx:id="tfNazione"  editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
                            <Label text="Città"    styleClass="info-key" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                            <TextField fx:id="tfCitta"    editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="4" GridPane.rowIndex="2"/>
                            <Label text="Indirizzo" styleClass="info-key" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
                            <TextField fx:id="tfIndirizzo" editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="4" GridPane.rowIndex="3"/>
                        </children>
                    </GridPane>
                </VBox>

                <!-- ── Card: Pagamento ── -->
                <VBox styleClass="content-card" spacing="14.0">
                    <padding><Insets top="22.0" bottom="22.0" left="24.0" right="24.0"/></padding>
                    <Label text="METODO DI PAGAMENTO" styleClass="section-title"/>
                    <Pane prefHeight="1.0" style="-fx-background-color: #1e3a5f;"/>
                    <GridPane hgap="24.0" vgap="12.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="110.0"/>
                            <ColumnConstraints hgrow="ALWAYS"    minWidth="160.0" prefWidth="260.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="30.0"  prefWidth="40.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="110.0"/>
                            <ColumnConstraints hgrow="ALWAYS"    minWidth="160.0" prefWidth="260.0"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="38.0" prefHeight="38.0"/>
                        </rowConstraints>
                        <children>
                            <Label text="N° carta"  styleClass="info-key" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <TextField fx:id="tfCarta"    editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label text="Scadenza"  styleClass="info-key" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                            <TextField fx:id="tfScadenza" editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
                        </children>
                    </GridPane>
                </VBox>

                <!-- ── Card: Cambio password ── -->
                <VBox styleClass="content-card" spacing="14.0">
                    <padding><Insets top="22.0" bottom="22.0" left="24.0" right="24.0"/></padding>
                    <Label text="CAMBIO PASSWORD" styleClass="section-title"/>
                    <Pane prefHeight="1.0" style="-fx-background-color: #1e3a5f;"/>
                    <HBox spacing="20.0" alignment="CENTER_LEFT">
                        <Label text="Nuova password" styleClass="info-key" prefWidth="120.0"/>
                        <PasswordField fx:id="pfNuovaPassword" promptText="Nuova password"
                                       styleClass="text-field-ModAero" prefWidth="200.0"/>
                        <Label text="Conferma" styleClass="info-key" prefWidth="70.0"/>
                        <PasswordField fx:id="pfConfermaPassword" promptText="Ripeti"
                                       styleClass="text-field-ModAero" prefWidth="200.0"/>
                        <Button text="Aggiorna" onAction="#handleCambioPassword"
                                styleClass="search-button"
                                style="-fx-font-size: 12px; -fx-padding: 8 16 8 16;"/>
                    </HBox>
                    <Label fx:id="lblFeedback" prefWidth="700.0" wrapText="true"
                           style="-fx-font-size: 12px;"/>
                </VBox>

            </VBox>
        </AnchorPane>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="FastRailStation.view.controller.ProfiloController">

    <!-- ══════════════════ HEADER NAV ══════════════════ -->
    <top>
        <GridPane prefHeight="120.0" prefWidth="1000.0" styleClass="header-nav"
                  BorderPane.alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="30.0"  minWidth="10.0" prefWidth="30.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="350.0" minWidth="10.0" prefWidth="280.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints maxHeight="40.0" minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints maxHeight="80.0" minHeight="50.0" prefHeight="70.0" vgrow="SOMETIMES"/>
                <RowConstraints maxHeight="30.0" minHeight="10.0" prefHeight="20.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <ImageView fitHeight="60.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true"
                           GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <image><Image url="@../../immagini/Logo.png"/></image>
                </ImageView>
                <Label fx:id="navHome"     alignment="CENTER" styleClass="nav-item"
                       text="Home"     GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <Label fx:id="navArrivi"   alignment="CENTER" styleClass="nav-item"
                       text="Arrivi"   GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                <Label fx:id="navPartenze" alignment="CENTER" styleClass="nav-item"
                       text="Partenze" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
                <Label fx:id="navPrenota"  alignment="CENTER" styleClass="nav-item"
                       text="Prenota"  GridPane.columnIndex="5" GridPane.rowIndex="1"/>
                <Label fx:id="navProfilo"  alignment="CENTER"
                       styleClass="nav-item, nav-item-active"
                       text="Profilo"  GridPane.columnIndex="6" GridPane.rowIndex="1"/>
            </children>
        </GridPane>
    </top>

    <!-- ══════════════════ CENTRO: card profilo ══════════════════ -->
    <center>
        <AnchorPane style="-fx-background-color: #0d1b2a;" BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="TOP_CENTER" spacing="20.0"
                      AnchorPane.topAnchor="30.0" AnchorPane.bottomAnchor="30.0"
                      AnchorPane.leftAnchor="80.0" AnchorPane.rightAnchor="80.0">

                    <!-- Titolo + azioni -->
                    <HBox alignment="CENTER_LEFT" spacing="20.0">
                        <Label text="👤  Il mio profilo"
                               style="-fx-text-fill: #f4e7e7; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                        <HBox HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnModifica" text="✏  Modifica"
                                onAction="#handleModifica"
                                style="-fx-background-color: #9a9aa3; -fx-text-fill: #800303; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 20 8 20;"/>
                        <Button fx:id="btnSalva" text="💾  Salva"
                                onAction="#handleSalva" disable="true"
                                style="-fx-background-color: #800303; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 20 8 20;"/>
                        <Button text="🚪  Logout"
                                onAction="#handleLogout"
                                style="-fx-background-color: #3d1515; -fx-text-fill: #ff6b6b; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 20 8 20;"/>
                    </HBox>

                    <Separator/>

                    <!-- Card dati personali -->
                    <VBox style="-fx-background-color: #112240; -fx-background-radius: 12; -fx-border-color: #1e3a5f; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 25;"
                          spacing="15.0">
                        <Label text="Dati personali"
                               style="-fx-text-fill: #800303; -fx-font-size: 14px; -fx-font-weight: bold;"/>

                        <GridPane hgap="20.0" vgap="12.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="130.0"/>
                                <ColumnConstraints hgrow="ALWAYS"    minWidth="180.0" prefWidth="280.0"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="30.0"  prefWidth="40.0"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="130.0"/>
                                <ColumnConstraints hgrow="ALWAYS"    minWidth="180.0" prefWidth="280.0"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="36.0" prefHeight="36.0"/>
                                <RowConstraints minHeight="36.0" prefHeight="36.0"/>
                                <RowConstraints minHeight="36.0" prefHeight="36.0"/>
                                <RowConstraints minHeight="36.0" prefHeight="36.0"/>
                            </rowConstraints>
                            <children>
                                <!-- Col sinistra -->
                                <Label text="Nome" styleClass="labelCustom1" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <TextField fx:id="tfNome"     editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                <Label text="E-mail" styleClass="labelCustom1" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <TextField fx:id="tfMail"     editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label text="Data di nascita" styleClass="labelCustom1" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <TextField fx:id="tfNascita"  editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                                <Label text="Cellulare" styleClass="labelCustom1" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <TextField fx:id="tfCellulare" editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                                <!-- Col destra -->
                                <Label text="Cognome" styleClass="labelCustom1" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                                <TextField fx:id="tfCognome"  editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="4" GridPane.rowIndex="0"/>

                                <Label text="Nazione" styleClass="labelCustom1" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                                <TextField fx:id="tfNazione"  editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="4" GridPane.rowIndex="1"/>

                                <Label text="Città" styleClass="labelCustom1" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                                <TextField fx:id="tfCitta"    editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="4" GridPane.rowIndex="2"/>

                                <Label text="Indirizzo" styleClass="labelCustom1" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
                                <TextField fx:id="tfIndirizzo" editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="4" GridPane.rowIndex="3"/>
                            </children>
                        </GridPane>
                    </VBox>

                    <!-- Card pagamento -->
                    <VBox style="-fx-background-color: #112240; -fx-background-radius: 12; -fx-border-color: #1e3a5f; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 25;"
                          spacing="15.0">
                        <Label text="Metodo di pagamento"
                               style="-fx-text-fill: #800303; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <GridPane hgap="20.0" vgap="12.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="130.0"/>
                                <ColumnConstraints hgrow="ALWAYS"    minWidth="180.0" prefWidth="280.0"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="30.0"  prefWidth="40.0"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="130.0"/>
                                <ColumnConstraints hgrow="ALWAYS"    minWidth="180.0" prefWidth="280.0"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="36.0" prefHeight="36.0"/>
                            </rowConstraints>
                            <children>
                                <Label text="N° carta" styleClass="labelCustom1" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <TextField fx:id="tfCarta"   editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <Label text="Scadenza" styleClass="labelCustom1" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                                <TextField fx:id="tfScadenza" editable="false" styleClass="text-field-ModAero" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
                            </children>
                        </GridPane>
                    </VBox>

                    <!-- Card cambio password -->
                    <VBox style="-fx-background-color: #112240; -fx-background-radius: 12; -fx-border-color: #1e3a5f; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 25;"
                          spacing="12.0">
                        <Label text="Cambio password"
                               style="-fx-text-fill: #800303; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <HBox spacing="20.0" alignment="CENTER_LEFT">
                            <Label text="Nuova password" styleClass="labelCustom1" prefWidth="130.0"/>
                            <PasswordField fx:id="pfNuovaPassword" promptText="Nuova password"
                                          styleClass="text-field-ModAero" prefWidth="200.0"/>
                            <Label text="Conferma" styleClass="labelCustom1" prefWidth="80.0"/>
                            <PasswordField fx:id="pfConfermaPassword" promptText="Ripeti"
                                          styleClass="text-field-ModAero" prefWidth="200.0"/>
                            <Button text="Aggiorna password" onAction="#handleCambioPassword"
                                    style="-fx-background-color: #800303; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16 8 16;"/>
                        </HBox>
                        <Label fx:id="lblFeedback" prefWidth="600.0" wrapText="true"
                               style="-fx-font-size: 13px;"/>
                    </VBox>

                </VBox>
            </children>
        </AnchorPane>
    </center>
</BorderPane>

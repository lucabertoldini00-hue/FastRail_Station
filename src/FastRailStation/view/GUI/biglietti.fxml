<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="620.0" prefWidth="960.0" stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="FastRailStation.view.controller.BigliettiController">

    <!-- ══ TOP BAR ══ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0"
              style="-fx-background-color: #9597a0; -fx-border-color: #800303; -fx-border-width: 0 0 2 0; -fx-padding: 14 22 14 22;"
              BorderPane.alignment="CENTER">
            <Button fx:id="btnHome" onAction="#handleBtnHome" styleClass="ghost-button" text="← Home" />
            <Label fx:id="lblOrologio" styleClass="timeLabel" text="00:00:00" />
            <HBox HBox.hgrow="ALWAYS" />
            <Pane prefHeight="22.0" prefWidth="3.0"
                  style="-fx-background-color: #800303; -fx-background-radius: 2;" />
            <Label style="-fx-text-fill: #f4e7e7; -fx-font-size: 20px; -fx-font-weight: bold;"
                   text="I miei biglietti" />
        </HBox>
    </top>

    <!-- ══ CENTER ══ -->
    <center>
        <VBox spacing="0.0" style="-fx-background-color: #7b7c81;" BorderPane.alignment="CENTER">

            <!-- Riepilogo utente -->
            <HBox alignment="CENTER_LEFT" spacing="32.0"
                  style="-fx-padding: 16 24 16 24; -fx-background-color: #6a6b70; -fx-border-color: #1e3a5f; -fx-border-width: 0 0 1 0;">
                <Pane prefHeight="20.0" prefWidth="3.0"
                      style="-fx-background-color: #800303; -fx-background-radius: 2;" />
                <Label fx:id="lblNome"
                       style="-fx-text-fill: #f4e7e7; -fx-font-size: 15px; -fx-font-weight: bold;"
                       text="—" />
                <HBox HBox.hgrow="ALWAYS" />
                <Label fx:id="lblTotaleViaggi"
                       style="-fx-text-fill: #9a9aa3; -fx-font-size: 13px;"
                       text="🎟  0 biglietti" />
                <Separator orientation="VERTICAL"
                           style="-fx-background-color: #1e3a5f;" prefHeight="20.0" />
                <Label fx:id="lblTotaleSpesa"
                       style="-fx-text-fill: #4cff72; -fx-font-size: 13px; -fx-font-weight: bold;"
                       text="💶  € 0 spesi in totale" />
            </HBox>

            <!-- Intestazione tabella -->
            <HBox alignment="CENTER_LEFT" spacing="12.0"
                  style="-fx-padding: 14 22 10 22; -fx-border-color: #1e3a5f; -fx-border-width: 0 0 1 0;">
                <Pane prefHeight="20.0" prefWidth="3.0"
                      style="-fx-background-color: #800303; -fx-background-radius: 2;" />
                <Label style="-fx-text-fill: #800303; -fx-font-size: 16px; -fx-font-weight: bold;"
                       text="STORICO PRENOTAZIONI" />
                <HBox HBox.hgrow="ALWAYS" />
                <Label fx:id="lblContatore"
                       style="-fx-text-fill: #4a5568; -fx-font-size: 12px;"
                       text="0 biglietti" />
            </HBox>

            <!-- Tabella biglietti -->
            <TableView fx:id="tblBiglietti" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodice"      prefWidth="190.0" text="Codice biglietto" />
                    <TableColumn fx:id="colTratta"      prefWidth="205.0" text="Tratta" />
                    <TableColumn fx:id="colData"        prefWidth="90.0"  text="Data" />
                    <TableColumn fx:id="colOrario"      prefWidth="72.0"  text="Orario" />
                    <TableColumn fx:id="colClasse"      prefWidth="100.0" text="Classe" />
                    <TableColumn fx:id="colPasseggeri"  prefWidth="90.0"  text="Passeggeri" />
                    <TableColumn fx:id="colBagagli"     prefWidth="72.0"  text="Bagagli" />
                    <TableColumn fx:id="colPrezzo"      prefWidth="80.0"  text="Prezzo" />
                    <TableColumn fx:id="colPrenotato"   prefWidth="155.0" text="Prenotato il" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <!-- Messaggio nessun biglietto -->
            <Label fx:id="lblNessunBiglietto"
                   alignment="CENTER"
                   prefWidth="960.0"
                   style="-fx-text-fill: #9a9aa3; -fx-font-size: 14px; -fx-padding: 20 0 0 0;"
                   text="Nessun biglietto trovato per questo account."
                   visible="false" managed="false" />
        </VBox>
    </center>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750.0" prefWidth="1200.0"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="FastRailStation.view.controller.AdminController">

    <!-- ══ ADMIN HEADER ══ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0"
              styleClass="admin-header"
              style="-fx-padding: 14 22 14 22;"
              BorderPane.alignment="CENTER">
            <Pane prefWidth="3.0" prefHeight="22.0"
                  style="-fx-background-color: #800303; -fx-background-radius: 2;"/>
            <Label text="FastRail  ·  Admin Panel" styleClass="admin-title"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblOrologio" text="00:00:00" styleClass="timeLabel"/>
            <Button text="← Home utente" onAction="#handleHomeUtente"
                    styleClass="ghost-button"/>
            <Button text="🚪 Logout" onAction="#handleLogout"
                    styleClass="danger-button"/>
        </HBox>
    </top>

    <!-- ══ SIDEBAR ══ -->
    <left>
        <VBox prefWidth="272.0" spacing="0.0" styleClass="sidebar"
              BorderPane.alignment="TOP_LEFT">
            <padding><Insets bottom="22.0" left="18.0" right="18.0" top="22.0"/></padding>

            <!-- ── FILTRI ── -->
            <Label text="FILTRI" styleClass="sidebar-title">
                <VBox.margin><Insets bottom="10.0"/></VBox.margin>
            </Label>
            <Pane prefHeight="1.0" prefWidth="236.0"
                  style="-fx-background-color: #1e3a5f;">
                <VBox.margin><Insets bottom="14.0"/></VBox.margin>
            </Pane>

            <!-- Mode toggle -->
            <HBox spacing="6.0">
                <VBox.margin><Insets bottom="14.0"/></VBox.margin>
                <Button fx:id="btnFiltroTutti"    text="Tutti"     onAction="#handleFiltroTutti"
                        prefWidth="55.0" prefHeight="32.0" styleClass="toggle-btn-active"/>
                <Button fx:id="btnFiltroPartenze" text="Partenze"  onAction="#handleFiltroPartenze"
                        prefWidth="55.0" prefHeight="32.0" styleClass="toggle-btn-inactive"/>
                <Button fx:id="btnFiltroArrivi"   text="Arrivi"    onAction="#handleFiltroArrivi"
                        prefWidth="55.0" prefHeight="32.0" styleClass="toggle-btn-inactive"/>
                <Button fx:id="btnFiltroManut"    text="Manut."    onAction="#handleFiltroManutenzione"
                        prefWidth="55.0" prefHeight="32.0" styleClass="toggle-btn-inactive"/>
            </HBox>

            <Label text="DATA" styleClass="form-label">
                <VBox.margin><Insets bottom="5.0"/></VBox.margin>
            </Label>
            <DatePicker fx:id="dpFiltroData" prefWidth="236.0" styleClass="customDatePicker">
                <VBox.margin><Insets bottom="12.0"/></VBox.margin>
            </DatePicker>

            <Label text="CERCA (DEST. / PROV.)" styleClass="form-label">
                <VBox.margin><Insets bottom="5.0"/></VBox.margin>
            </Label>
            <TextField fx:id="txtFiltroCerca" promptText="Roma, Napoli…" styleClass="customTextField" prefWidth="236.0">
                <VBox.margin><Insets bottom="12.0"/></VBox.margin>
            </TextField>

            <Label text="COMPAGNIA" styleClass="form-label">
                <VBox.margin><Insets bottom="5.0"/></VBox.margin>
            </Label>
            <TextField fx:id="txtFiltroCompagnia" promptText="Trenitalia, Italo…" styleClass="customTextField" prefWidth="236.0">
                <VBox.margin><Insets bottom="14.0"/></VBox.margin>
            </TextField>

            <Button text="🔍  Applica filtro" onAction="#handleApplicaFiltro"
                    prefWidth="236.0" prefHeight="36.0"
                    styleClass="search-button">
                <VBox.margin><Insets bottom="6.0"/></VBox.margin>
            </Button>
            <Button text="↺  Reset" onAction="#handleResetFiltro"
                    prefWidth="236.0" prefHeight="36.0"
                    styleClass="ghost-button">
                <VBox.margin><Insets bottom="22.0"/></VBox.margin>
            </Button>

            <!-- ── AGGIUNGI TRENO ── -->
            <Pane prefHeight="1.0" prefWidth="236.0"
                  style="-fx-background-color: #1e3a5f;">
                <VBox.margin><Insets bottom="14.0"/></VBox.margin>
            </Pane>
            <Label text="AGGIUNGI TRENO" styleClass="sidebar-title">
                <VBox.margin><Insets bottom="12.0"/></VBox.margin>
            </Label>

            <Label text="MODELLO" styleClass="form-label">
                <VBox.margin><Insets bottom="5.0"/></VBox.margin>
            </Label>
            <ComboBox fx:id="cmbModello" prefWidth="236.0" styleClass="combo-box-ModAereo">
                <VBox.margin><Insets bottom="10.0"/></VBox.margin>
            </ComboBox>

            <Label text="PROVENIENZA" styleClass="form-label">
                <VBox.margin><Insets bottom="5.0"/></VBox.margin>
            </Label>
            <TextField fx:id="tfProvenienza" promptText="Milano Centrale" styleClass="text-field-ModAero" prefWidth="236.0">
                <VBox.margin><Insets bottom="10.0"/></VBox.margin>
            </TextField>

            <Label text="DESTINAZIONE" styleClass="form-label">
                <VBox.margin><Insets bottom="5.0"/></VBox.margin>
            </Label>
            <TextField fx:id="tfDestinazione" promptText="Roma Termini" styleClass="text-field-ModAero" prefWidth="236.0">
                <VBox.margin><Insets bottom="10.0"/></VBox.margin>
            </TextField>

            <Label text="COMPAGNIA" styleClass="form-label">
                <VBox.margin><Insets bottom="5.0"/></VBox.margin>
            </Label>
            <TextField fx:id="tfCompagnia" promptText="Trenitalia" styleClass="text-field-ModAero" prefWidth="236.0">
                <VBox.margin><Insets bottom="10.0"/></VBox.margin>
            </TextField>

            <Label text="CODICE TRENO" styleClass="form-label">
                <VBox.margin><Insets bottom="5.0"/></VBox.margin>
            </Label>
            <TextField fx:id="tfCodice" promptText="FR100" styleClass="text-field-ModAero" prefWidth="236.0">
                <VBox.margin><Insets bottom="10.0"/></VBox.margin>
            </TextField>

            <!-- Ora row -->
            <HBox spacing="10.0">
                <VBox.margin><Insets bottom="10.0"/></VBox.margin>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="ORA ARRIVO" styleClass="form-label"/>
                    <TextField fx:id="tfOraArrivo" promptText="06:30" styleClass="text-field-ModAero"/>
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="ORA PARTENZA" styleClass="form-label"/>
                    <TextField fx:id="tfOraPartenza" promptText="07:10" styleClass="text-field-ModAero"/>
                </VBox>
            </HBox>

            <!-- Posti row -->
            <HBox spacing="10.0">
                <VBox.margin><Insets bottom="10.0"/></VBox.margin>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="POSTI MAX" styleClass="form-label"/>
                    <TextField fx:id="tfPostiMax" promptText="500" styleClass="text-field-ModAero"/>
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="INTERVALLO GG" styleClass="form-label"/>
                    <TextField fx:id="tfIntervallo" promptText="1" styleClass="text-field-ModAero"/>
                </VBox>
            </HBox>

            <Label text="STATO" styleClass="form-label">
                <VBox.margin><Insets bottom="5.0"/></VBox.margin>
            </Label>
            <ComboBox fx:id="cmbStato" prefWidth="236.0" styleClass="combo-box-ModAereo">
                <VBox.margin><Insets bottom="14.0"/></VBox.margin>
            </ComboBox>

            <Button text="➕  Aggiungi treno" onAction="#handleAggiungiTreno"
                    prefWidth="236.0" prefHeight="40.0"
                    styleClass="search-button"
                    style="-fx-font-size: 13px;">
                <VBox.margin><Insets bottom="8.0"/></VBox.margin>
            </Button>

            <Label fx:id="lblAggiungiMsg" prefWidth="236.0" wrapText="true"
                   style="-fx-font-size: 12px;"/>
        </VBox>
    </left>

    <!-- ══ MAIN TABLE ══ -->
    <center>
        <VBox style="-fx-background-color: #0d1b2a;" spacing="0.0"
              BorderPane.alignment="CENTER">

            <!-- Bar -->
            <HBox alignment="CENTER_LEFT" spacing="14.0"
                  style="-fx-padding: 16 22 12 22; -fx-border-color: #1e3a5f; -fx-border-width: 0 0 1 0;">
                <Pane prefWidth="3.0" prefHeight="20.0"
                      style="-fx-background-color: #800303; -fx-background-radius: 2;"/>
                <Label fx:id="lblTitolo" text="TUTTI I TRENI"
                       style="-fx-text-fill: #800303; -fx-font-size: 17px; -fx-font-weight: bold; -fx-font-family: 'Courier New', monospace;"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblContatore" text="0 treni"
                       style="-fx-text-fill: #4a5568; -fx-font-size: 12px;"/>
            </HBox>

            <!-- Table -->
            <TableView fx:id="tblTreni" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colModello"      text="Modello"      prefWidth="160.0" minWidth="100.0"/>
                    <TableColumn fx:id="colProvenienza"  text="Provenienza"  prefWidth="140.0" minWidth="100.0"/>
                    <TableColumn fx:id="colDestinazione" text="Destinazione" prefWidth="140.0" minWidth="100.0"/>
                    <TableColumn fx:id="colCompagnia"    text="Compagnia"    prefWidth="110.0" minWidth="80.0"/>
                    <TableColumn fx:id="colCodice"       text="Codice"       prefWidth="85.0"  minWidth="70.0"/>
                    <TableColumn fx:id="colBinario"      text="Binario"      prefWidth="70.0"  minWidth="55.0"/>
                    <TableColumn fx:id="colOraArrivo"    text="Arrivo"       prefWidth="75.0"  minWidth="60.0"/>
                    <TableColumn fx:id="colOraPartenza"  text="Partenza"     prefWidth="75.0"  minWidth="60.0"/>
                    <TableColumn fx:id="colStato"        text="Stato"        prefWidth="115.0" minWidth="90.0"/>
                    <TableColumn fx:id="colRitardo"      text="Ritardo"      prefWidth="70.0"  minWidth="55.0"/>
                    <TableColumn fx:id="colAzioni"       text="Azioni"       prefWidth="95.0"  minWidth="90.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

</BorderPane>

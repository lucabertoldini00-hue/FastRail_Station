<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="1000.0" maxWidth="1600.0" minHeight="983.0" minWidth="1600.0" prefHeight="983.0" prefWidth="1600.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="FastRailStation.view.controller.AdminController">

    <top>
        <HBox alignment="CENTER_LEFT" maxHeight="80.0" maxWidth="1617.0" minHeight="75.0" minWidth="1150.0" prefHeight="80.0" prefWidth="1617.0" spacing="20.0" style="-fx-padding: 8 22 8 22;" styleClass="admin-header" BorderPane.alignment="CENTER_RIGHT">
            <Pane maxHeight="45.0" maxWidth="5.0" minHeight="45.0" minWidth="5.0" prefHeight="45.0" prefWidth="5.0" style="-fx-background-color: #800303; -fx-background-radius: 2;" />
            <Label prefHeight="18.0" prefWidth="179.0" styleClass="admin-title" text="FastRail  ·  Admin Panel">
                <HBox.margin>
                    <Insets left="6.0" />
                </HBox.margin>
            </Label>
            <HBox HBox.hgrow="ALWAYS" />
            <Label fx:id="lblOrologio" styleClass="timeLabel" text="00:00:00" />
            <Button onAction="#handleHomeUtente" styleClass="ghost-button" text="← Home utente" />
            <Button onAction="#handleLogout" styleClass="danger-button" text="➡ Logout" />
        </HBox>
    </top>

    <left>
        <VBox prefHeight="993.0" prefWidth="450.0" spacing="0.0" styleClass="sidebar" BorderPane.alignment="TOP_LEFT">
            <padding><Insets bottom="22.0" left="20.0" right="20.0" /></padding>

            <Label styleClass="sidebar-title" text="FILTRI">
                <VBox.margin><Insets bottom="10.0" /></VBox.margin>
            </Label>
            <Pane prefHeight="1.0" prefWidth="236.0" style="-fx-background-color: #1e3a5f;">
                <VBox.margin><Insets bottom="14.0" /></VBox.margin>
            </Pane>

            <HBox fillHeight="false" spacing="6.0">
                <VBox.margin><Insets bottom="14.0" /></VBox.margin>
                <Button fx:id="btnFiltroTutti" onAction="#handleFiltroTutti" prefHeight="38.0" prefWidth="85.0" styleClass="toggle-btn-active" text="Tutti" />
                <Button fx:id="btnFiltroPartenze" onAction="#handleFiltroPartenze" prefHeight="38.0" prefWidth="107.0" styleClass="toggle-btn-inactive" text="Partenze" />
                <Button fx:id="btnFiltroArrivi" onAction="#handleFiltroArrivi" prefHeight="38.0" prefWidth="99.0" styleClass="toggle-btn-inactive" text="Arrivi" />
                <Button fx:id="btnFiltroManut" onAction="#handleFiltroManutenzione" prefHeight="38.0" prefWidth="104.0" styleClass="toggle-btn-inactive" text="Manut." />
            </HBox>

            <Label styleClass="form-label" text="DATA">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Label>
            <DatePicker fx:id="dpFiltroData" prefWidth="236.0" styleClass="customDatePicker">
                <VBox.margin><Insets bottom="12.0" /></VBox.margin>
            </DatePicker>

            <Label styleClass="form-label" text="CERCA (DEST. / PROV.)">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Label>
            <TextField fx:id="txtFiltroCerca" prefWidth="236.0" promptText="Roma, Napoli…" styleClass="customTextField">
                <VBox.margin><Insets bottom="12.0" /></VBox.margin>
            </TextField>

            <Label styleClass="form-label" text="COMPAGNIA">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Label>
            <TextField fx:id="txtFiltroCompagnia" prefWidth="236.0" promptText="Trenitalia, Italo…" styleClass="customTextField">
                <VBox.margin><Insets bottom="14.0" /></VBox.margin>
            </TextField>
         <HBox prefHeight="100.0" prefWidth="200.0" spacing="20.0">
            <children>
      
                  <Button onAction="#handleApplicaFiltro" prefHeight="37.0" prefWidth="185.0" styleClass="search-button" text="🔍  Applica filtro" />
                  <Button onAction="#handleResetFiltro" prefHeight="38.0" prefWidth="191.0" styleClass="ghost-button" text="↺  Reset" textAlignment="CENTER" />
            </children>
         </HBox>

            <Pane prefHeight="1.0" prefWidth="236.0" style="-fx-background-color: #1e3a5f;">
                <VBox.margin><Insets bottom="14.0" /></VBox.margin>
            </Pane>
            <Label styleClass="sidebar-title" text="AGGIUNGI TRENO">
                <VBox.margin><Insets bottom="12.0" /></VBox.margin>
            </Label>

            <Label styleClass="form-label" text="MODELLO">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Label>
            <ComboBox fx:id="cmbModello" prefWidth="236.0" styleClass="combo-box-ModAereo">
                <VBox.margin><Insets bottom="10.0" /></VBox.margin>
            </ComboBox>

            <Label styleClass="form-label" text="PROVENIENZA">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Label>
            <TextField fx:id="tfProvenienza" prefWidth="236.0" promptText="Milano Centrale" styleClass="text-field-ModAero">
                <VBox.margin><Insets bottom="10.0" /></VBox.margin>
            </TextField>

            <Label styleClass="form-label" text="DESTINAZIONE">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Label>
            <TextField fx:id="tfDestinazione" prefWidth="236.0" promptText="Roma Termini" styleClass="text-field-ModAero">
                <VBox.margin><Insets bottom="10.0" /></VBox.margin>
            </TextField>

            <Label styleClass="form-label" text="COMPAGNIA">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Label>
            <TextField fx:id="tfCompagnia" prefWidth="236.0" promptText="Trenitalia" styleClass="text-field-ModAero">
                <VBox.margin><Insets bottom="10.0" /></VBox.margin>
            </TextField>

            <Label styleClass="form-label" text="CODICE TRENO">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Label>
            <TextField fx:id="tfCodice" prefWidth="236.0" promptText="FR100" styleClass="text-field-ModAero">
                <VBox.margin><Insets bottom="10.0" /></VBox.margin>
            </TextField>

            <HBox spacing="10.0">
                <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="ORA ARRIVO" />
                    <TextField fx:id="tfOraArrivo" promptText="hh:mm" styleClass="text-field-ModAero" />
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="ORA PARTENZA" />
                    <TextField fx:id="tfOraPartenza" promptText="hh:mm" styleClass="text-field-ModAero" />
                </VBox>
            </HBox>

            <HBox spacing="10.0">
                <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="POSTI MAX" />
                    <TextField fx:id="tfPostiMax" promptText="500" styleClass="text-field-ModAero" />
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="INTERVALLO GG" />
                    <TextField fx:id="tfIntervallo" promptText="1" styleClass="text-field-ModAero" />
                </VBox>
            </HBox>

            <Label styleClass="form-label" text="STATO">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Label>
            <ComboBox fx:id="cmbStato" prefWidth="236.0" styleClass="combo-box-ModAereo">
                <VBox.margin><Insets bottom="14.0" /></VBox.margin>
            </ComboBox>

            <Button onAction="#handleAggiungiTreno" prefHeight="40.0" prefWidth="236.0" style="-fx-font-size: 13px;" styleClass="search-button" text="➕  Aggiungi treno">
                <VBox.margin><Insets bottom="8.0" /></VBox.margin>
            </Button>

            <Label fx:id="lblAggiungiMsg" prefWidth="236.0" style="-fx-font-size: 12px;" wrapText="true" />
        </VBox>
    </left>

    <center>
        <VBox maxHeight="900.0" maxWidth="1150.0" minHeight="900.0" minWidth="1150.0" prefHeight="900.0" prefWidth="1150.0" spacing="0.0" style="-fx-background-color: #7b7c81;" BorderPane.alignment="CENTER_RIGHT">

            <HBox alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="1100.0" spacing="14.0" style="-fx-padding: 12 22 10 22; -fx-border-color: #1e3a5f; -fx-border-width: 0 0 1 0;">
                <Pane prefHeight="20.0" prefWidth="3.0" style="-fx-background-color: #800303; -fx-background-radius: 2;" />
                <Label fx:id="lblTitolo" style="-fx-text-fill: #800303; -fx-font-size: 17px; -fx-font-weight: bold; -fx-font-family: 'Courier New', monospace;" text="TUTTI I TRENI" />
                <HBox HBox.hgrow="ALWAYS" />
                <Label fx:id="lblContatore" style="-fx-text-fill: #4a5568; -fx-font-size: 12px;" text="0 treni" />
            </HBox>

            <TableView fx:id="tblTreni" prefHeight="848.0" prefWidth="1236.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colModello" minWidth="100.0" prefWidth="160.0" text="Modello" />
                    <TableColumn fx:id="colProvenienza" minWidth="100.0" prefWidth="140.0" text="Provenienza" />
                    <TableColumn fx:id="colDestinazione" minWidth="100.0" prefWidth="140.0" text="Destinazione" />
                    <TableColumn fx:id="colCompagnia" minWidth="80.0" prefWidth="110.0" text="Compagnia" />
                    <TableColumn fx:id="colCodice" minWidth="70.0" prefWidth="85.0" text="Codice" />
                    <TableColumn fx:id="colBinario" minWidth="55.0" prefWidth="70.0" text="Binario" />
                    <TableColumn fx:id="colOraArrivo" minWidth="60.0" prefWidth="75.0" text="Arrivo" />
                    <TableColumn fx:id="colOraPartenza" minWidth="60.0" prefWidth="75.0" text="Partenza" />
                    <TableColumn fx:id="colStato" minWidth="90.0" prefWidth="115.0" text="Stato" />
                    <TableColumn fx:id="colRitardo" minWidth="55.0" prefWidth="70.0" text="Ritardo" />
                    <TableColumn fx:id="colAzioni" minWidth="90.0" prefWidth="95.0" text="Azioni" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1200.0"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="FastRailStation.view.controller.AdminController">

    <!-- ══════════════════ HEADER ADMIN ══════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0"
              style="-fx-background-color: #0d1b2a; -fx-border-color: #800303; -fx-border-width: 0 0 2 0; -fx-padding: 12 20 12 20;"
              BorderPane.alignment="CENTER">
            <Label text="⚙  FastRail Admin Panel"
                   style="-fx-text-fill: #800303; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblOrologio" text="00:00:00" styleClass="timeLabel"/>
            <Button text="← Home utente" onAction="#handleHomeUtente"
                    style="-fx-background-color: #2a3a4a; -fx-text-fill: #9a9aa3; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16 8 16;"/>
            <Button text="🚪 Logout" onAction="#handleLogout"
                    style="-fx-background-color: #3d1515; -fx-text-fill: #ff6b6b; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16 8 16;"/>
        </HBox>
    </top>

    <!-- ══════════════════ SIDEBAR ADMIN ══════════════════ -->
    <left>
        <VBox prefWidth="260.0" spacing="0.0"
              style="-fx-background-color: #1a2a3a; -fx-border-color: #2a3a4a; -fx-border-width: 0 1 0 0;"
              BorderPane.alignment="TOP_LEFT">
            <padding><Insets bottom="20.0" left="15.0" right="15.0" top="20.0"/></padding>

            <Label text="FILTRI" styleClass="timeLabel" style="-fx-font-size: 13px;"/>
            <Separator style="-fx-background-color: #2a3a4a;"/>

            <!-- Modalità -->
            <HBox spacing="4.0" style="-fx-padding: 12 0 12 0;">
                <Button fx:id="btnFiltroTutti"     text="Tutti"      onAction="#handleFiltroTutti"
                        prefWidth="58.0" prefHeight="30.0"
                        style="-fx-background-color: #800303; -fx-text-fill: white; -fx-font-size: 11px; -fx-background-radius: 4;"/>
                <Button fx:id="btnFiltroPartenze"  text="Partenze"   onAction="#handleFiltroPartenze"
                        prefWidth="58.0" prefHeight="30.0"
                        style="-fx-background-color: #2a3a4a; -fx-text-fill: #9a9aa3; -fx-font-size: 11px; -fx-background-radius: 4;"/>
                <Button fx:id="btnFiltroArrivi"    text="Arrivi"     onAction="#handleFiltroArrivi"
                        prefWidth="58.0" prefHeight="30.0"
                        style="-fx-background-color: #2a3a4a; -fx-text-fill: #9a9aa3; -fx-font-size: 11px; -fx-background-radius: 4;"/>
                <Button fx:id="btnFiltroManut"     text="Manut."     onAction="#handleFiltroManutenzione"
                        prefWidth="58.0" prefHeight="30.0"
                        style="-fx-background-color: #2a3a4a; -fx-text-fill: #9a9aa3; -fx-font-size: 11px; -fx-background-radius: 4;"/>
            </HBox>

            <Label text="Data" styleClass="labelCustom1" style="-fx-font-size: 12px; -fx-padding: 4 0 3 0;"/>
            <DatePicker fx:id="dpFiltroData" prefWidth="230.0" styleClass="customDatePicker">
                <VBox.margin><Insets bottom="8.0"/></VBox.margin>
            </DatePicker>

            <Label text="Cerca (dest. / prov.)" styleClass="labelCustom1" style="-fx-font-size: 11px; -fx-padding: 4 0 3 0;"/>
            <TextField fx:id="txtFiltroCerca" promptText="Roma, Napoli…" styleClass="customTextField" prefWidth="230.0">
                <VBox.margin><Insets bottom="8.0"/></VBox.margin>
            </TextField>

            <Label text="Compagnia" styleClass="labelCustom1" style="-fx-font-size: 11px; -fx-padding: 4 0 3 0;"/>
            <TextField fx:id="txtFiltroCompagnia" promptText="Trenitalia, Italo…" styleClass="customTextField" prefWidth="230.0">
                <VBox.margin><Insets bottom="8.0"/></VBox.margin>
            </TextField>

            <Button text="🔍  Applica filtro" onAction="#handleApplicaFiltro"
                    prefWidth="230.0" prefHeight="34.0"
                    style="-fx-background-color: #800303; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;">
                <VBox.margin><Insets bottom="6.0"/></VBox.margin>
            </Button>
            <Button text="↺  Reset" onAction="#handleResetFiltro"
                    prefWidth="230.0" prefHeight="34.0"
                    style="-fx-background-color: #2a3a4a; -fx-text-fill: #9a9aa3; -fx-font-weight: bold; -fx-background-radius: 6;">
                <VBox.margin><Insets bottom="20.0"/></VBox.margin>
            </Button>

            <Separator style="-fx-background-color: #2a3a4a;"/>

            <!-- AGGIUNGI TRENO -->
            <Label text="AGGIUNGI TRENO" styleClass="timeLabel"
                   style="-fx-font-size: 12px; -fx-padding: 15 0 8 0;"/>

            <Label text="Modello" styleClass="labelCustom1" style="-fx-font-size: 11px;"/>
            <ComboBox fx:id="cmbModello" prefWidth="230.0" styleClass="combo-box-ModAereo">
                <VBox.margin><Insets bottom="6.0"/></VBox.margin>
            </ComboBox>

            <Label text="Provenienza" styleClass="labelCustom1" style="-fx-font-size: 11px;"/>
            <TextField fx:id="tfProvenienza" promptText="es. Milano Centrale" styleClass="text-field-ModAero" prefWidth="230.0">
                <VBox.margin><Insets bottom="6.0"/></VBox.margin>
            </TextField>

            <Label text="Destinazione" styleClass="labelCustom1" style="-fx-font-size: 11px;"/>
            <TextField fx:id="tfDestinazione" promptText="es. Roma Termini" styleClass="text-field-ModAero" prefWidth="230.0">
                <VBox.margin><Insets bottom="6.0"/></VBox.margin>
            </TextField>

            <Label text="Compagnia" styleClass="labelCustom1" style="-fx-font-size: 11px;"/>
            <TextField fx:id="tfCompagnia" promptText="es. Trenitalia" styleClass="text-field-ModAero" prefWidth="230.0">
                <VBox.margin><Insets bottom="6.0"/></VBox.margin>
            </TextField>

            <Label text="Codice treno" styleClass="labelCustom1" style="-fx-font-size: 11px;"/>
            <TextField fx:id="tfCodice" promptText="es. FR100" styleClass="text-field-ModAero" prefWidth="230.0">
                <VBox.margin><Insets bottom="6.0"/></VBox.margin>
            </TextField>

            <HBox spacing="8.0">
                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <Label text="Ora arrivo (HH:mm)" styleClass="labelCustom1" style="-fx-font-size: 10px;"/>
                    <TextField fx:id="tfOraArrivo" promptText="06:30" styleClass="text-field-ModAero"/>
                </VBox>
                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <Label text="Ora partenza (HH:mm)" styleClass="labelCustom1" style="-fx-font-size: 10px;"/>
                    <TextField fx:id="tfOraPartenza" promptText="07:10" styleClass="text-field-ModAero"/>
                </VBox>
            </HBox>

            <HBox spacing="8.0" style="-fx-padding: 6 0 6 0;">
                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <Label text="Posti max" styleClass="labelCustom1" style="-fx-font-size: 10px;"/>
                    <TextField fx:id="tfPostiMax" promptText="500" styleClass="text-field-ModAero"/>
                </VBox>
                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <Label text="Intervallo gg" styleClass="labelCustom1" style="-fx-font-size: 10px;"/>
                    <TextField fx:id="tfIntervallo" promptText="1" styleClass="text-field-ModAero"/>
                </VBox>
            </HBox>

            <Label text="Stato" styleClass="labelCustom1" style="-fx-font-size: 11px;"/>
            <ComboBox fx:id="cmbStato" prefWidth="230.0" styleClass="combo-box-ModAereo">
                <VBox.margin><Insets bottom="10.0"/></VBox.margin>
            </ComboBox>

            <Button text="➕  Aggiungi treno" onAction="#handleAggiungiTreno"
                    prefWidth="230.0" prefHeight="36.0"
                    style="-fx-background-color: #800303; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-font-size: 13px;">
                <VBox.margin><Insets bottom="8.0"/></VBox.margin>
            </Button>

            <Label fx:id="lblAggiungiMsg" prefWidth="230.0" wrapText="true"
                   style="-fx-font-size: 12px;"/>
        </VBox>
    </left>

    <!-- ══════════════════ MAIN: tabella + dettaglio ══════════════════ -->
    <center>
        <VBox style="-fx-background-color: #0d1b2a;" spacing="0.0"
              BorderPane.alignment="CENTER">

            <!-- Barra superiore -->
            <HBox alignment="CENTER_LEFT" spacing="15.0"
                  style="-fx-padding: 12 20 8 20; -fx-border-color: #1e3a5f; -fx-border-width: 0 0 1 0;">
                <Label fx:id="lblTitolo" text="TUTTI I TRENI"
                       style="-fx-text-fill: #800303; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Courier New', monospace;"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblContatore" text="0 treni"
                       style="-fx-text-fill: #9a9aa3; -fx-font-size: 12px;"/>
            </HBox>

            <!-- Tabella -->
            <TableView fx:id="tblTreni" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colModello"      text="Modello"      prefWidth="160.0" minWidth="100.0"/>
                    <TableColumn fx:id="colProvenienza"  text="Provenienza"  prefWidth="150.0" minWidth="100.0"/>
                    <TableColumn fx:id="colDestinazione" text="Destinazione" prefWidth="150.0" minWidth="100.0"/>
                    <TableColumn fx:id="colCompagnia"    text="Compagnia"    prefWidth="110.0" minWidth="80.0"/>
                    <TableColumn fx:id="colCodice"       text="Codice"       prefWidth="90.0"  minWidth="70.0"/>
                    <TableColumn fx:id="colBinario"      text="Binario"      prefWidth="70.0"  minWidth="55.0"/>
                    <TableColumn fx:id="colOraArrivo"    text="Arrivo"       prefWidth="75.0"  minWidth="60.0"/>
                    <TableColumn fx:id="colOraPartenza"  text="Partenza"     prefWidth="75.0"  minWidth="60.0"/>
                    <TableColumn fx:id="colStato"        text="Stato"        prefWidth="120.0" minWidth="90.0"/>
                    <TableColumn fx:id="colRitardo"      text="Ritardo"      prefWidth="75.0"  minWidth="55.0"/>
                    <TableColumn fx:id="colAzioni"       text="Azioni"       prefWidth="100.0" minWidth="90.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

        </VBox>
    </center>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0" prefWidth="1008.0" styleClass="root" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="FastRailStation.view.controller.UserController">
    <children>

        <!-- ══════════════════ SFONDO ══════════════════ -->
        <ImageView fitHeight="600.0" fitWidth="1008.0" layoutY="119.0" opacity="0.55" pickOnBounds="true" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="119.0">
            <image><Image url="@../../immagini/Sfondo1.jpg" /></image>
        </ImageView>

        <!-- Overlay scuro -->
        <Pane maxHeight="600.0" minHeight="100.0" prefHeight="100.0" prefWidth="1008.0" style="-fx-background-color: rgba(13,27,42,0.50);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="119.0">
            <padding><Insets top="30.0" /></padding>
        </Pane>

        <!-- ══════════════════ HEADER NAV ══════════════════ -->
        <!--
            Colonne:
            0 = spacer (30)
            1 = logo   (317) ← ridotto da 427 per fare spazio alla nuova voce
            2 = Home   (33)
            3 = Arrivi   (100)
            4 = Partenze (100)
            5 = Prenota  (100)
            6 = Biglietti (110)  ← NUOVO
            7 = Profilo  (100)
        -->
        <GridPane prefHeight="119.0" prefWidth="1008.0" styleClass="header-nav" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <columnConstraints>
                <!-- 0: margine sinistro -->
                <ColumnConstraints hgrow="NEVER" maxWidth="20.0" minWidth="20.0" prefWidth="20.0" />
                <!-- 1: logo — si restringe per dare spazio uniforme alle tab -->
                <ColumnConstraints hgrow="ALWAYS" maxWidth="340.0" minWidth="140.0" prefWidth="240.0" />
                <!-- 2-7: voci nav tutte uguali -->
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="75.0" prefWidth="90.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="75.0" prefWidth="90.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="120.0" minWidth="85.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="75.0" prefWidth="90.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="130.0" minWidth="90.0" prefWidth="110.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="75.0" prefWidth="90.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints maxHeight="40.0" minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="80.0" minHeight="50.0" prefHeight="70.0" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="30.0" minHeight="10.0" prefHeight="20.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <!-- Logo -->
                <ImageView fitHeight="73.0" fitWidth="220.0" onMouseClicked="#handleLogoClick" pickOnBounds="true" preserveRatio="true" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.valignment="CENTER">
                    <image><Image url="@../../immagini/Logo.png" /></image>
                </ImageView>

                <!-- Voci nav -->
                <Label fx:id="navHome" alignment="CENTER" styleClass="nav-item, nav-item-active" text="🏠 Home" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <Label fx:id="navArrivi" alignment="CENTER" styleClass="nav-item" text="▼ Arrivi" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                <Label fx:id="navPartenze" alignment="CENTER" styleClass="nav-item" text="▲ Partenze" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                <Label fx:id="navPrenota" alignment="CENTER" styleClass="nav-item" text="💰 Prenota" GridPane.columnIndex="5" GridPane.rowIndex="1" />
                <!-- NUOVO: Biglietti -->
                <Label fx:id="navBiglietti" alignment="CENTER" styleClass="nav-item" text="🎟 Biglietti" GridPane.columnIndex="6" GridPane.rowIndex="1" />
                <!-- Profilo / nome utente -->
                <Label fx:id="navProfilo" alignment="CENTER" styleClass="nav-item" text="➡ Profilo" GridPane.columnIndex="7" GridPane.rowIndex="1" />
            </children>
        </GridPane>

        <!-- ══════════════════ HERO CONTENT ══════════════════ -->
        <VBox alignment="TOP_CENTER" spacing="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="119.0">

            <!-- Sottotitolo hero -->
            <Label alignment="BOTTOM_CENTER" prefHeight="112.0" prefWidth="1008.0" style="-fx-text-fill: #9a9aa3; -fx-font-size: 15px; -fx-letter-spacing: 3px; -fx-padding: 40 0 6 0;" text="Il tuo viaggio inizia qui" />

            <!-- Titolo principale -->
            <Label alignment="CENTER" prefHeight="58.0" prefWidth="1008.0" style="-fx-font-size: 42px; -fx-text-fill: #f4e7e7; -fx-font-weight: bold;" styleClass="main-title" text="Cerca il tuo treno">
                <VBox.margin><Insets bottom="30.0" /></VBox.margin>
            </Label>

            <!-- ══ SEARCH CARD ══ -->
            <Pane maxWidth="780.0" prefHeight="110.0" prefWidth="780.0" style="-fx-background-color: rgba(17,34,64,0.95); -fx-border-color: #1e3a5f; -fx-border-width: 1; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 20, 0, 0, 4);" styleClass="search-form-container">
                <children>
                    <HBox alignment="CENTER" layoutX="0.0" layoutY="0.0" prefHeight="110.0" prefWidth="780.0" spacing="6.0" styleClass="search-form-container">
                        <padding><Insets left="24.0" right="24.0" /></padding>

                        <!-- DA -->
                        <VBox alignment="CENTER_LEFT" prefHeight="68.0" prefWidth="118.0" spacing="4.0">
                            <Label alignment="TOP_LEFT" prefHeight="2.0" prefWidth="15.0" style="-fx-text-fill: #ffffff; -fx-font-size: 10px; -fx-letter-spacing: 2px; -fx-font-weight: bold;" text="DA">
                                <padding><Insets bottom="4.0" /></padding>
                            </Label>
                            <Label prefHeight="19.0" prefWidth="202.0" style="-fx-text-fill: #f4e7e7; -fx-font-size: 15px; -fx-font-weight: bold;" text="FastRail Station" />
                        </VBox>

                        <!-- Freccia -->
                        <Label alignment="BOTTOM_CENTER" prefHeight="42.0" prefWidth="79.0" style="-fx-text-fill: #800303; -fx-font-size: 28px; -fx-padding: 0 16 0 16;" text="⟶" />

                        <!-- A -->
                        <VBox alignment="CENTER_LEFT" prefWidth="167.0" spacing="4.0">
                            <HBox.margin><Insets right="20.0" /></HBox.margin>
                            <Label style="-fx-text-fill: #ffffff; -fx-font-size: 10px; -fx-letter-spacing: 2px; -fx-font-weight: bold;" text="A" />
                            <TextField fx:id="searchDestinazione" prefHeight="36.0" prefWidth="161.0" promptText="Destinazione" styleClass="station-input" />
                        </VBox>

                        <!-- Data -->
                        <VBox alignment="CENTER_LEFT" prefWidth="170.0" spacing="4.0">
                            <HBox.margin><Insets right="20.0" /></HBox.margin>
                            <Label style="-fx-text-fill: #ffffff; -fx-font-size: 10px; -fx-letter-spacing: 2px; -fx-font-weight: bold;" text="DATA" />
                            <DatePicker fx:id="searchData" prefHeight="34.0" prefWidth="170.0" promptText="Seleziona la data" styleClass="customDatePicker" />
                        </VBox>

                        <!-- CERCA -->
                        <Button fx:id="btnCerca" onAction="#handleCerca" prefHeight="44.0" prefWidth="110.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8;" styleClass="search-button" text="CERCA" />
                    </HBox>
                </children>
            </Pane>

            <!-- ══ QUICK-LINKS ══ -->
            <HBox alignment="CENTER" spacing="18.0">
                <VBox.margin><Insets top="40.0" /></VBox.margin>

                <!-- Card Arrivi -->
                <Pane onMouseClicked="#handleQuickArrivi" prefHeight="100.0" prefWidth="185.0" style="-fx-background-color: rgba(128,3,3,0.75); -fx-border-color: #1e3a5f; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-cursor: hand;">
                    <children>
                        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="185.0" spacing="6.0">
                            <Label style="-fx-text-fill: #ffffff; -fx-font-size: 26px;" text="▼" />
                            <Label style="-fx-text-fill: #f4e7e7; -fx-font-size: 14px; -fx-font-weight: bold;" text="ARRIVI" />
                            <Label style="-fx-text-fill: #9a9aa3; -fx-font-size: 11px;" text="Tabellone arrivi" />
                        </VBox>
                    </children>
                </Pane>

                <!-- Card Partenze -->
                <Pane onMouseClicked="#handleQuickPartenze" prefHeight="100.0" prefWidth="185.0" style="-fx-background-color: rgba(128,3,3,0.75); -fx-border-color: #1e3a5f; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-cursor: hand;">
                    <children>
                        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="185.0" spacing="6.0">
                            <Label style="-fx-text-fill: #ffffff; -fx-font-size: 26px;" text="▲" />
                            <Label style="-fx-text-fill: #f4e7e7; -fx-font-size: 14px; -fx-font-weight: bold;" text="PARTENZE" />
                            <Label style="-fx-text-fill: #9a9aa3; -fx-font-size: 11px;" text="Tabellone partenze" />
                        </VBox>
                    </children>
                </Pane>

                <!-- Card Prenota -->
                <Pane onMouseClicked="#handleQuickPrenota" prefHeight="100.0" prefWidth="185.0" style="-fx-background-color: rgba(128,3,3,0.75); -fx-border-color: #800303; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-cursor: hand;">
                    <children>
                        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="185.0" spacing="6.0">
                            <Label style="-fx-font-size: 26px;" text="💰" />
                            <Label style="-fx-text-fill: #f4e7e7; -fx-font-size: 14px; -fx-font-weight: bold;" text="PRENOTA" />
                            <Label style="-fx-text-fill: #f4e7e7; -fx-font-size: 11px;" text="Acquista il tuo biglietto" />
                        </VBox>
                    </children>
                </Pane>

                <!-- Card Biglietti ← NUOVO -->
                <Pane onMouseClicked="#handleQuickBiglietti" prefHeight="100.0" prefWidth="185.0" style="-fx-background-color: rgba(128,3,3,0.75); -fx-border-color: #800303; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-cursor: hand;">
                    <children>
                        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="185.0" spacing="6.0">
                            <Label style="-fx-font-size: 26px;" text="🎟" />
                            <Label style="-fx-text-fill: #f4e7e7; -fx-font-size: 14px; -fx-font-weight: bold;" text="BIGLIETTI" />
                            <Label style="-fx-text-fill: #9a9aa3; -fx-font-size: 11px;" text="I miei acquisti" />
                        </VBox>
                    </children>
                </Pane>

            </HBox>

            <!-- Footer -->
            <Label alignment="CENTER" prefHeight="41.0" prefWidth="1008.0" style="-fx-text-fill: #9a9aa3; -fx-font-size: 11px;" text="FastRail Station  •  Biglietti  •  Orari  •  Assistenza">
                <VBox.margin><Insets top="50.0" /></VBox.margin>
            </Label>

        </VBox>
    </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

    <?import javafx.geometry.Insets?>
    <?import javafx.scene.control.Button?>
    <?import javafx.scene.control.DatePicker?>
    <?import javafx.scene.control.Label?>
    <?import javafx.scene.control.TextField?>
    <?import javafx.scene.image.Image?>
    <?import javafx.scene.image.ImageView?>
    <?import javafx.scene.layout.AnchorPane?>
    <?import javafx.scene.layout.ColumnConstraints?>
    <?import javafx.scene.layout.GridPane?>
    <?import javafx.scene.layout.HBox?>
    <?import javafx.scene.layout.Pane?>
    <?import javafx.scene.layout.RowConstraints?>
    <?import javafx.scene.layout.VBox?>
    <?import javafx.scene.text.Font?>

    <AnchorPane prefHeight="700.0" prefWidth="1000.0"
                styleClass="root" stylesheets="@styles.css"
                xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
                fx:controller="FastRailStation.view.controller.UserController">
        <children>

            <!-- ══════════════════ SFONDO ══════════════════ -->
            <ImageView fitHeight="583.0" fitWidth="1008.0" layoutY="117.0"
                       opacity="0.55" pickOnBounds="true" preserveRatio="false"
                       AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                       AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="117.0">
                <image><Image url="@../../immagini/Sfondo1.jpg"/></image>
            </ImageView>

            <!-- Overlay scuro sopra lo sfondo per leggibilità -->
            <Pane style="-fx-background-color: rgba(13,27,42,0.65);"
                  AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                  AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="117.0"/>

            <!-- ══════════════════ HEADER NAV ══════════════════ -->
            <GridPane prefHeight="120.0" prefWidth="1000.0" styleClass="header-nav"
                      AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" maxWidth="30.0"  minWidth="10.0" prefWidth="30.0"/>
                    <ColumnConstraints hgrow="SOMETIMES" maxWidth="350.0" minWidth="10.0" prefWidth="280.0"/>
                    <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
                    <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
                    <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
                    <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
                    <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints maxHeight="40.0"  minHeight="10.0" prefHeight="30.0"  vgrow="SOMETIMES"/>
                    <RowConstraints maxHeight="80.0"  minHeight="50.0" prefHeight="70.0"  vgrow="SOMETIMES"/>
                    <RowConstraints maxHeight="30.0"  minHeight="10.0" prefHeight="20.0"  vgrow="SOMETIMES"/>
                </rowConstraints>
                <children>
                    <ImageView fitHeight="60.0" fitWidth="180.0" pickOnBounds="true"
                               preserveRatio="true"
                               GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <image><Image url="@../../immagini/Logo.png"/></image>
                    </ImageView>
                    <Label fx:id="navHome"     alignment="CENTER" styleClass="nav-item, nav-item-active"
                           text="Home"     GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <Label fx:id="navArrivi"   alignment="CENTER" styleClass="nav-item"
                           text="Arrivi"   GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                    <Label fx:id="navPartenze" alignment="CENTER" styleClass="nav-item"
                           text="Partenze" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
                    <Label fx:id="navPrenota"  alignment="CENTER" styleClass="nav-item"
                           text="Prenota"  GridPane.columnIndex="5" GridPane.rowIndex="1"/>
                    <!-- navProfilo: mostra nome utente se loggato, "Profilo" altrimenti -->
                    <Label fx:id="navProfilo"  alignment="CENTER" styleClass="nav-item"
                           text="Profilo"  GridPane.columnIndex="6" GridPane.rowIndex="1"/>
                </children>
            </GridPane>

            <!-- ══════════════════ HERO CONTENT ══════════════════ -->
            <VBox alignment="TOP_CENTER" spacing="0.0"
                  AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                  AnchorPane.topAnchor="117.0" AnchorPane.bottomAnchor="0.0">

                <!-- Sottotitolo hero -->
                <Label text="Il tuo viaggio inizia qui"
                       style="-fx-text-fill: #9a9aa3; -fx-font-size: 15px; -fx-letter-spacing: 3px; -fx-padding: 40 0 6 0;"
                       alignment="CENTER" prefWidth="1000.0"/>

                <!-- Titolo principale -->
                <Label text="Cerca il tuo treno"
                       styleClass="main-title"
                       style="-fx-font-size: 42px; -fx-text-fill: #f4e7e7; -fx-font-weight: bold;"
                       alignment="CENTER" prefWidth="1000.0">
                    <VBox.margin><Insets bottom="30.0"/></VBox.margin>
                </Label>

                <!-- ══ SEARCH CARD ══ -->
                <Pane prefHeight="110.0" prefWidth="780.0" maxWidth="780.0"
                      styleClass="search-form-container"
                      style="-fx-background-color: rgba(17,34,64,0.95); -fx-border-color: #1e3a5f; -fx-border-width: 1; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 20, 0, 0, 4);">
                    <children>
                        <HBox alignment="CENTER" spacing="0.0"
                              layoutX="0.0" layoutY="0.0" prefWidth="780.0" prefHeight="110.0">
                            <padding><Insets left="24.0" right="24.0"/></padding>

                            <!-- Stazione di partenza (fissa) -->
                            <VBox alignment="CENTER_LEFT" spacing="4.0" prefWidth="160.0">
                                <Label text="DA" style="-fx-text-fill: #9a9aa3; -fx-font-size: 10px; -fx-letter-spacing: 2px; -fx-font-weight: bold;"/>
                                <Label text="FastRail Station"
                                       style="-fx-text-fill: #f4e7e7; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                            </VBox>

                            <!-- Freccia separatore -->
                            <Label text="⟶"
                                   style="-fx-text-fill: #800303; -fx-font-size: 28px; -fx-padding: 0 16 0 16;"/>

                            <!-- Destinazione -->
                            <VBox alignment="CENTER_LEFT" spacing="4.0" prefWidth="200.0">
                                <HBox.margin><Insets right="20.0"/></HBox.margin>
                                <Label text="A" style="-fx-text-fill: #9a9aa3; -fx-font-size: 10px; -fx-letter-spacing: 2px; -fx-font-weight: bold;"/>
                                <TextField fx:id="searchDestinazione"
                                           promptText="Destinazione"
                                           styleClass="station-input"
                                           prefHeight="34.0" prefWidth="200.0"/>
                            </VBox>

                            <!-- Separatore verticale -->
                            <Pane prefWidth="1.0" prefHeight="60.0"
                                  style="-fx-background-color: #1e3a5f;">
                                <HBox.margin><Insets left="10.0" right="24.0"/></HBox.margin>
                            </Pane>

                            <!-- Data -->
                            <VBox alignment="CENTER_LEFT" spacing="4.0" prefWidth="170.0">
                                <HBox.margin><Insets right="20.0"/></HBox.margin>
                                <Label text="DATA" style="-fx-text-fill: #9a9aa3; -fx-font-size: 10px; -fx-letter-spacing: 2px; -fx-font-weight: bold;"/>
                                <DatePicker fx:id="searchData"
                                            styleClass="customDatePicker"
                                            prefHeight="34.0" prefWidth="170.0"/>
                            </VBox>

                            <!-- Separatore verticale -->
                            <Pane prefWidth="1.0" prefHeight="60.0"
                                  style="-fx-background-color: #1e3a5f;">
                                <HBox.margin><Insets left="10.0" right="24.0"/></HBox.margin>
                            </Pane>

                            <!-- Pulsante CERCA -->
                            <Button fx:id="btnCerca" text="CERCA"
                                    onAction="#handleCerca"
                                    styleClass="search-button"
                                    prefHeight="44.0" prefWidth="110.0"
                                    style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                        </HBox>
                    </children>
                </Pane>

                <!-- ══ QUICK-LINKS ══ -->
                <HBox alignment="CENTER" spacing="20.0">
                    <VBox.margin><Insets top="40.0"/></VBox.margin>

                    <!-- Card Arrivi -->
                    <Pane prefWidth="200.0" prefHeight="100.0" onMouseClicked="#handleQuickArrivi"
                          style="-fx-background-color: rgba(17,34,64,0.85); -fx-border-color: #1e3a5f; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-cursor: hand;">
                        <children>
                            <VBox alignment="CENTER" prefWidth="200.0" prefHeight="100.0" spacing="6.0">
                                <Label text="▼" style="-fx-text-fill: #ffdd57; -fx-font-size: 26px;"/>
                                <Label text="ARRIVI" style="-fx-text-fill: #f4e7e7; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                                <Label text="Tabellone arrivi" style="-fx-text-fill: #9a9aa3; -fx-font-size: 11px;"/>
                            </VBox>
                        </children>
                    </Pane>

                    <!-- Card Partenze -->
                    <Pane prefWidth="200.0" prefHeight="100.0" onMouseClicked="#handleQuickPartenze"
                          style="-fx-background-color: rgba(17,34,64,0.85); -fx-border-color: #1e3a5f; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-cursor: hand;">
                        <children>
                            <VBox alignment="CENTER" prefWidth="200.0" prefHeight="100.0" spacing="6.0">
                                <Label text="▲" style="-fx-text-fill: #4cff72; -fx-font-size: 26px;"/>
                                <Label text="PARTENZE" style="-fx-text-fill: #f4e7e7; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                                <Label text="Tabellone partenze" style="-fx-text-fill: #9a9aa3; -fx-font-size: 11px;"/>
                            </VBox>
                        </children>
                    </Pane>

                    <!-- Card Prenota -->
                    <Pane prefWidth="200.0" prefHeight="100.0" onMouseClicked="#handleQuickPrenota"
                          style="-fx-background-color: rgba(128,3,3,0.75); -fx-border-color: #800303; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-cursor: hand;">
                        <children>
                            <VBox alignment="CENTER" prefWidth="200.0" prefHeight="100.0" spacing="6.0">
                                <Label text="🎫" style="-fx-font-size: 26px;"/>
                                <Label text="PRENOTA" style="-fx-text-fill: #f4e7e7; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                                <Label text="Acquista il tuo biglietto" style="-fx-text-fill: #f4e7e7; -fx-font-size: 11px;"/>
                            </VBox>
                        </children>
                    </Pane>

                </HBox>

                <!-- Footer info -->
                <Label text="FastRail Station  •  Biglietti  •  Orari  •  Assistenza"
                       style="-fx-text-fill: #4a5568; -fx-font-size: 11px;"
                       alignment="CENTER" prefWidth="1000.0">
                    <VBox.margin><Insets top="50.0"/></VBox.margin>
                </Label>

            </VBox>
        </children>
    </AnchorPane>

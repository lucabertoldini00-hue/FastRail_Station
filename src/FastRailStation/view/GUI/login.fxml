<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="580.0" prefWidth="520.0"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/8.0.391" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="FastRailStation.view.controller.LoginController">

    <center>
        <!-- Full dark background -->
        <AnchorPane style="-fx-background-color: #0d1b2a;"
                    BorderPane.alignment="CENTER">

            <!-- Centered auth card -->
            <VBox alignment="TOP_CENTER" spacing="0.0"
                  maxWidth="400.0" prefWidth="400.0"
                  styleClass="auth-card"
                  AnchorPane.topAnchor="40.0"
                  AnchorPane.leftAnchor="60.0"
                  AnchorPane.rightAnchor="60.0">

                <!-- Home button top-left overlay -->
                <Button fx:id="btnHome" text="← Home" onAction="#handleBtnHome"
                        styleClass="auth-ghost-button">
                    <VBox.margin><Insets bottom="20.0"/></VBox.margin>
                </Button>

                <!-- Accent line -->
                <Pane prefHeight="2.0" prefWidth="60.0"
                      style="-fx-background-color: #800303; -fx-background-radius: 2;">
                    <VBox.margin><Insets bottom="18.0"/></VBox.margin>
                </Pane>

                <!-- Title -->
                <Label text="Accedi" styleClass="auth-title" alignment="CENTER"
                       prefWidth="320.0">
                    <VBox.margin><Insets bottom="6.0"/></VBox.margin>
                </Label>

                <!-- Subtitle link -->
                <HBox alignment="CENTER" spacing="6.0">
                    <VBox.margin><Insets bottom="32.0"/></VBox.margin>
                    <Label text="Non hai un account?" styleClass="auth-subtitle"/>
                    <Hyperlink fx:id="vaiRegistrati" text="Registrati"
                               onAction="#handleRegistratiLink"
                               style="-fx-text-fill: #800303; -fx-border-color: transparent; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                </HBox>

                <!-- Email label -->
                <Label text="EMAIL" styleClass="auth-label">
                    <VBox.margin><Insets bottom="6.0"/></VBox.margin>
                </Label>
                <!-- Email field -->
                <TextField fx:id="inserisciMail" promptText="nome@dominio.com"
                           styleClass="auth-field" prefHeight="44.0" prefWidth="320.0">
                    <VBox.margin><Insets bottom="20.0"/></VBox.margin>
                </TextField>

                <!-- Password label -->
                <Label text="PASSWORD" styleClass="auth-label">
                    <VBox.margin><Insets bottom="6.0"/></VBox.margin>
                </Label>

                <!-- Password row -->
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <VBox.margin><Insets bottom="8.0"/></VBox.margin>
                    <PasswordField fx:id="inserisciPassword"
                                  promptText="La mia password"
                                  styleClass="auth-field"
                                  prefHeight="44.0" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="vediInserisciPassword"
                               promptText="La mia password"
                               styleClass="auth-field"
                               prefHeight="44.0" HBox.hgrow="ALWAYS"/>
                    <CheckBox fx:id="visualizzaPassword"
                              onAction="#visualizza"
                              prefWidth="24.0" prefHeight="24.0"/>
                </HBox>

                <!-- Forgot password -->
                <HBox alignment="CENTER_RIGHT">
                    <VBox.margin><Insets bottom="24.0"/></VBox.margin>
                    <Label text="Password dimenticata? " styleClass="auth-subtitle"/>
                    <Hyperlink fx:id="vaiResetPassword" text="Reimposta"
                               onAction="#handlePasswChangeLink"
                               style="-fx-text-fill: #800303; -fx-border-color: transparent; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                </HBox>

                <!-- Error label -->
                <Label fx:id="segnalaErrore" alignment="CENTER"
                       styleClass="error-label"
                       prefHeight="24.0" prefWidth="320.0">
                    <VBox.margin><Insets bottom="10.0"/></VBox.margin>
                </Label>

                <!-- Login button -->
                <Button text="ACCEDI" onAction="#login"
                        styleClass="auth-button"
                        prefHeight="48.0" prefWidth="320.0">
                    <VBox.margin><Insets bottom="4.0"/></VBox.margin>
                </Button>

            </VBox>
        </AnchorPane>
    </center>
</BorderPane>

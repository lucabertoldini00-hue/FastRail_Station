<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="FastRailStation.view.controller.UserMainController">

    <!-- ══ HEADER NAV ══ -->
    <top>
        <GridPane prefHeight="117.0" prefWidth="1100.0" styleClass="header-nav" BorderPane.alignment="CENTER">
            <columnConstraints>
                <!-- 0: margine sinistro -->
                <ColumnConstraints hgrow="NEVER" maxWidth="20.0" minWidth="20.0" prefWidth="20.0" />
                <!-- 1: logo -->
                <ColumnConstraints hgrow="ALWAYS" maxWidth="382.0" minWidth="140.0" prefWidth="382.0" />
                <!-- 2-7: voci nav tutte uguali -->
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="68.0" prefWidth="68.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="75.0" prefWidth="90.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="120.0" minWidth="85.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="75.0" prefWidth="90.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="130.0" minWidth="90.0" prefWidth="110.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="75.0" prefWidth="90.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints maxHeight="20.0" minHeight="10.0" prefHeight="18.0" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="80.0" minHeight="50.0" prefHeight="70.0" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="30.0" minHeight="10.0" prefHeight="29.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <ImageView fitHeight="73.0" fitWidth="242.0" onMouseClicked="#handleLogoClick" pickOnBounds="true" preserveRatio="true" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <image><Image url="@../../immagini/Logo.png" /></image>
                </ImageView>
                <Label fx:id="navHome" alignment="CENTER" styleClass="nav-item" text="🏠 Home" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <Label fx:id="navArrivi" alignment="CENTER" styleClass="nav-item, nav-item-active" text="▼ Arrivi" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                <Label fx:id="navPartenze" alignment="CENTER" styleClass="nav-item" text="▲ Partenze" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                <Label fx:id="navPrenota" alignment="CENTER" styleClass="nav-item" text="💰 Prenota" GridPane.columnIndex="5" GridPane.rowIndex="1" />
                <Label fx:id="navBiglietti" alignment="CENTER" styleClass="nav-item" text="🎟 Biglietti" textAlignment="CENTER" GridPane.columnIndex="6" GridPane.rowIndex="1" />
                <Label fx:id="navProfilo" alignment="CENTER" styleClass="nav-item" text="➡ Profilo" GridPane.columnIndex="7" GridPane.rowIndex="1" />
            </children>
        </GridPane>
    </top>

    <!-- ══ SIDEBAR ══ -->
    <left>
        <VBox prefHeight="583.0" prefWidth="295.0" spacing="0.0" styleClass="sidebar" BorderPane.alignment="TOP_LEFT">
            <padding><Insets bottom="24.0" left="18.0" right="18.0" top="24.0" /></padding>

            <!-- Section title -->
            <Label styleClass="sidebar-title" text="TABELLONE">
                <VBox.margin><Insets bottom="10.0" /></VBox.margin>
            </Label>
            <Pane prefHeight="2.0" prefWidth="194.0" style="-fx-background-color: #800303;">
                <VBox.margin><Insets bottom="18.0" /></VBox.margin>
            </Pane>

            <!-- Toggle Arrivi / Partenze -->
            <HBox spacing="0.0">
                <VBox.margin><Insets bottom="20.0" /></VBox.margin>
                <Button fx:id="btnArrivi" onAction="#handleArrivi" prefHeight="38.0" prefWidth="117.0" style="-fx-background-radius: 8 0 0 8;" styleClass="toggle-btn-active" text="▼  ARRIVI" />
                <Button fx:id="btnPartenze" onAction="#handlePartenze" prefHeight="38.0" prefWidth="140.0" style="-fx-background-radius: 0 8 8 0;" styleClass="toggle-btn-inactive" text="▲  PARTENZE" />
            </HBox>

            <!-- Data -->
            <Label styleClass="form-label" text="DATA">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Label>
            <DatePicker fx:id="dpData" prefHeight="38.0" prefWidth="261.0" styleClass="customDatePicker">
                <VBox.margin><Insets bottom="16.0" /></VBox.margin>
            </DatePicker>

            <!-- Cerca -->
            <Label styleClass="form-label" text="DESTINAZIONE / PROVENIENZA" wrapText="true">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Label>
            <TextField fx:id="txtCerca" prefWidth="194.0" promptText="es. Roma, Napoli…" styleClass="customTextField">
                <VBox.margin><Insets bottom="16.0" /></VBox.margin>
            </TextField>

            <!-- Compagnia -->
            <Label styleClass="form-label" text="COMPAGNIA">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Label>
            <TextField fx:id="txtCompagnia" prefWidth="194.0" promptText="es. Trenitalia, Italo…" styleClass="customTextField">
                <VBox.margin><Insets bottom="20.0" /></VBox.margin>
            </TextField>

            <!-- Action buttons -->
            <Button alignment="CENTER" onAction="#handleFiltra" prefHeight="38.0" prefWidth="194.0" styleClass="search-button" text="🔍  Filtra">
                <VBox.margin><Insets bottom="8.0" left="28.0" /></VBox.margin>
            </Button>
            <Button onAction="#handleReset" prefHeight="38.0" prefWidth="194.0" styleClass="ghost-button" text="↺  Reset">
                <VBox.margin><Insets bottom="24.0" left="28.0" /></VBox.margin>
            </Button>

            <!-- Divider -->
            <Pane prefHeight="2.0" prefWidth="259.0" style="-fx-background-color: #800303;">
                <VBox.margin><Insets bottom="18.0" /></VBox.margin>
            </Pane>

            <!-- Clock -->
            <Label fx:id="lblOrologio" alignment="CENTER" prefHeight="23.0" prefWidth="258.0" styleClass="timeLabel" text="00:00:00">
                <VBox.margin><Insets bottom="6.0" /></VBox.margin>
            </Label>

            <!-- Counter -->
            <Label fx:id="lblContatore" alignment="CENTER" prefWidth="258.0" style="-fx-text-fill: #800303; -fx-font-size: 16px; -fx-font-weight: bold;" text="0 treni" />
        </VBox>
    </left>

    <!-- ══ MAIN TABLE ══ -->
    <center>
        <VBox maxWidth="815.0" minWidth="815.0" prefHeight="583.0" prefWidth="815.0" style="-fx-background-color: #7b7c81;" BorderPane.alignment="CENTER_RIGHT">

            <!-- Title bar -->
            <HBox alignment="CENTER_LEFT" spacing="14.0" style="-fx-padding: 18 22 14 22; -fx-border-color: #1e3a5f; -fx-border-width: 0 0 1 0;">
                <Pane prefHeight="22.0" prefWidth="3.0" style="-fx-background-color: #800303; -fx-background-radius: 2;" />
                <Label fx:id="lblTitoloTabellone" style="-fx-text-fill: #800303; -fx-font-size: 20px; -fx-font-weight: bold; -fx-font-family: 'Courier New', monospace;" text="◉  ARRIVI" />
                <HBox HBox.hgrow="ALWAYS" />
                <Label style="-fx-font-size: 11px; -fx-opacity: 0.5;" styleClass="labelCustom1" text="FastRail Station" />
            </HBox>

            <!-- Table -->
            <TableView fx:id="tblTabellone" style="-fx-background-color: #9597a0;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colOrario" minWidth="70.0" prefWidth="90.0" text="Orario" />
                    <TableColumn fx:id="colProvenienza" minWidth="120.0" prefWidth="170.0" text="Provenienza" />
                    <TableColumn fx:id="colDestinazione" minWidth="120.0" prefWidth="170.0" text="Destinazione" />
                    <TableColumn fx:id="colCodice" minWidth="80.0" prefWidth="100.0" text="N° Treno" />
                    <TableColumn fx:id="colBinario" minWidth="60.0" prefWidth="80.0" text="Binario" />
                    <TableColumn fx:id="colCompagnia" minWidth="90.0" prefWidth="120.0" text="Compagnia" />
                    <TableColumn fx:id="colStato" minWidth="90.0" prefWidth="120.0" text="Stato" />
                    <TableColumn fx:id="colRitardo" minWidth="60.0" prefWidth="85.0" text="Ritardo" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

</BorderPane>

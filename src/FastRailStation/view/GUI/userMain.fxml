<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="FastRailStation.view.controller.UserMainController">

    <!-- ══ HEADER NAV ══ -->
    <top>
        <GridPane prefHeight="117.0" prefWidth="1100.0" styleClass="header-nav"
                  BorderPane.alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="30.0"  minWidth="10.0" prefWidth="30.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="350.0" minWidth="10.0" prefWidth="300.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="80.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="30.0"  minWidth="10.0" prefWidth="30.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints maxHeight="20.0" minHeight="10.0" prefHeight="18.0" vgrow="SOMETIMES"/>
                <RowConstraints maxHeight="80.0" minHeight="50.0" prefHeight="70.0" vgrow="SOMETIMES"/>
                <RowConstraints maxHeight="30.0" minHeight="10.0" prefHeight="29.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <ImageView fitHeight="60.0" fitWidth="200.0" pickOnBounds="true"
                           preserveRatio="true"
                           GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <image><Image url="@../../immagini/Logo.png"/></image>
                </ImageView>
                <Label fx:id="navHome"     alignment="CENTER" styleClass="nav-item"
                       text="Home"     GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <Label fx:id="navArrivi"   alignment="CENTER" styleClass="nav-item, nav-item-active"
                       text="Arrivi"   GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                <Label fx:id="navPartenze" alignment="CENTER" styleClass="nav-item"
                       text="Partenze" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
                <Label fx:id="navPrenota"  alignment="CENTER" styleClass="nav-item"
                       text="Prenota"  GridPane.columnIndex="5" GridPane.rowIndex="1"/>
                <Label fx:id="navProfilo"  alignment="CENTER" styleClass="nav-item"
                       text="Profilo"  GridPane.columnIndex="6" GridPane.rowIndex="1"/>
            </children>
        </GridPane>
    </top>

    <!-- ══ SIDEBAR ══ -->
    <left>
        <VBox prefWidth="230.0" spacing="0.0" styleClass="sidebar"
              BorderPane.alignment="TOP_LEFT">
            <padding><Insets bottom="24.0" left="18.0" right="18.0" top="24.0"/></padding>

            <!-- Section title -->
            <Label text="TABELLONE" styleClass="sidebar-title">
                <VBox.margin><Insets bottom="10.0"/></VBox.margin>
            </Label>
            <Pane prefHeight="1.0" prefWidth="194.0"
                  style="-fx-background-color: #1e3a5f;">
                <VBox.margin><Insets bottom="18.0"/></VBox.margin>
            </Pane>

            <!-- Toggle Arrivi / Partenze -->
            <HBox spacing="0.0">
                <VBox.margin><Insets bottom="20.0"/></VBox.margin>
                <Button fx:id="btnArrivi" text="▼  ARRIVI"
                        onAction="#handleArrivi"
                        prefWidth="97.0" prefHeight="38.0"
                        styleClass="toggle-btn-active"
                        style="-fx-background-radius: 8 0 0 8;"/>
                <Button fx:id="btnPartenze" text="▲  PARTENZE"
                        onAction="#handlePartenze"
                        prefWidth="97.0" prefHeight="38.0"
                        styleClass="toggle-btn-inactive"
                        style="-fx-background-radius: 0 8 8 0;"/>
            </HBox>

            <!-- Data -->
            <Label text="DATA" styleClass="form-label">
                <VBox.margin><Insets bottom="5.0"/></VBox.margin>
            </Label>
            <DatePicker fx:id="dpData" prefWidth="194.0" styleClass="customDatePicker">
                <VBox.margin><Insets bottom="16.0"/></VBox.margin>
            </DatePicker>

            <!-- Cerca -->
            <Label text="DESTINAZIONE / PROVENIENZA" styleClass="form-label" wrapText="true">
                <VBox.margin><Insets bottom="5.0"/></VBox.margin>
            </Label>
            <TextField fx:id="txtCerca" promptText="es. Roma, Napoli…"
                       styleClass="customTextField" prefWidth="194.0">
                <VBox.margin><Insets bottom="16.0"/></VBox.margin>
            </TextField>

            <!-- Compagnia -->
            <Label text="COMPAGNIA" styleClass="form-label">
                <VBox.margin><Insets bottom="5.0"/></VBox.margin>
            </Label>
            <TextField fx:id="txtCompagnia" promptText="es. Trenitalia, Italo…"
                       styleClass="customTextField" prefWidth="194.0">
                <VBox.margin><Insets bottom="20.0"/></VBox.margin>
            </TextField>

            <!-- Action buttons -->
            <Button text="🔍  Filtra" onAction="#handleFiltra"
                    prefWidth="194.0" prefHeight="38.0"
                    styleClass="search-button">
                <VBox.margin><Insets bottom="8.0"/></VBox.margin>
            </Button>
            <Button text="↺  Reset" onAction="#handleReset"
                    prefWidth="194.0" prefHeight="38.0"
                    styleClass="ghost-button">
                <VBox.margin><Insets bottom="24.0"/></VBox.margin>
            </Button>

            <!-- Divider -->
            <Pane prefHeight="1.0" prefWidth="194.0"
                  style="-fx-background-color: #1e3a5f;">
                <VBox.margin><Insets bottom="18.0"/></VBox.margin>
            </Pane>

            <!-- Clock -->
            <Label fx:id="lblOrologio" text="00:00:00" styleClass="timeLabel"
                   alignment="CENTER" prefWidth="194.0">
                <VBox.margin><Insets bottom="6.0"/></VBox.margin>
            </Label>

            <!-- Counter -->
            <Label fx:id="lblContatore" text="0 treni" styleClass="labelCustom1"
                   style="-fx-font-size: 11px; -fx-padding: 0 0 0 2px;"/>
        </VBox>
    </left>

    <!-- ══ MAIN TABLE ══ -->
    <center>
        <VBox style="-fx-background-color: #0d1b2a;" BorderPane.alignment="CENTER">

            <!-- Title bar -->
            <HBox alignment="CENTER_LEFT" spacing="14.0"
                  style="-fx-padding: 18 22 14 22; -fx-border-color: #1e3a5f; -fx-border-width: 0 0 1 0;">
                <Pane prefWidth="3.0" prefHeight="22.0"
                      style="-fx-background-color: #800303; -fx-background-radius: 2;"/>
                <Label fx:id="lblTitoloTabellone" text="◉  ARRIVI"
                       style="-fx-text-fill: #800303; -fx-font-size: 20px; -fx-font-weight: bold; -fx-font-family: 'Courier New', monospace;"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Label text="FastRail Station" styleClass="labelCustom1"
                       style="-fx-font-size: 11px; -fx-opacity: 0.5;"/>
            </HBox>

            <!-- Table -->
            <TableView fx:id="tblTabellone" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colOrario"       text="Orario"       prefWidth="90.0"  minWidth="70.0"/>
                    <TableColumn fx:id="colProvenienza"  text="Provenienza"  prefWidth="170.0" minWidth="120.0"/>
                    <TableColumn fx:id="colDestinazione" text="Destinazione" prefWidth="170.0" minWidth="120.0"/>
                    <TableColumn fx:id="colCodice"       text="N° Treno"     prefWidth="100.0" minWidth="80.0"/>
                    <TableColumn fx:id="colBinario"      text="Binario"      prefWidth="80.0"  minWidth="60.0"/>
                    <TableColumn fx:id="colCompagnia"    text="Compagnia"    prefWidth="120.0" minWidth="90.0"/>
                    <TableColumn fx:id="colStato"        text="Stato"        prefWidth="120.0" minWidth="90.0"/>
                    <TableColumn fx:id="colRitardo"      text="Ritardo"      prefWidth="85.0"  minWidth="60.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

</BorderPane>

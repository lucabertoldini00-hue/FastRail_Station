<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="636.0" prefWidth="880.0"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="FastRailStation.view.controller.PrenotazioneController">

    <!-- ══ TOP BAR ══ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0"
              style="-fx-background-color: linear-gradient(to right, #060f1a, #0d1b2a); -fx-border-color: #800303; -fx-border-width: 0 0 2 0; -fx-padding: 14 22 14 22;"
              BorderPane.alignment="CENTER">
            <Button fx:id="btnHome" text="← Home" onAction="#handleBtnHome"
                    styleClass="ghost-button"/>
            <Label fx:id="lblOrologio" text="00:00:00" styleClass="timeLabel"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Pane prefWidth="3.0" prefHeight="22.0"
                  style="-fx-background-color: #800303; -fx-background-radius: 2;"/>
            <Label text="Prenotazione"
                   style="-fx-text-fill: #f4e7e7; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnAccedi" text="Accedi" onAction="#handleBtnAccedi"
                    styleClass="accediButton"/>
        </HBox>
    </top>

    <!-- ══ SIDEBAR ══ -->
    <left>
        <VBox prefWidth="248.0" spacing="0.0" styleClass="sidebar"
              BorderPane.alignment="TOP_LEFT">
            <padding><Insets top="22.0" bottom="22.0" left="18.0" right="18.0"/></padding>

            <!-- Search section -->
            <Label text="RICERCA TRENO" styleClass="sidebar-title">
                <VBox.margin><Insets bottom="12.0"/></VBox.margin>
            </Label>
            <Pane prefHeight="1.0" prefWidth="212.0"
                  style="-fx-background-color: #1e3a5f;">
                <VBox.margin><Insets bottom="16.0"/></VBox.margin>
            </Pane>

            <!-- Date -->
            <Label text="DATA PARTENZA" styleClass="form-label">
                <VBox.margin><Insets bottom="5.0"/></VBox.margin>
            </Label>
            <DatePicker fx:id="dpDataPartenza" promptText="Data"
                        styleClass="customDatePicker" prefWidth="212.0">
                <VBox.margin><Insets bottom="14.0"/></VBox.margin>
            </DatePicker>

            <!-- Destination -->
            <Label text="DESTINAZIONE" styleClass="form-label">
                <VBox.margin><Insets bottom="5.0"/></VBox.margin>
            </Label>
            <TextField fx:id="txtDestinazione" promptText="Destinazione"
                       styleClass="customTextField" prefWidth="212.0">
                <VBox.margin><Insets bottom="20.0"/></VBox.margin>
            </TextField>

            <!-- Passengers section -->
            <Label text="PASSEGGERI" styleClass="sidebar-title">
                <VBox.margin><Insets bottom="12.0"/></VBox.margin>
            </Label>
            <Pane prefHeight="1.0" prefWidth="212.0"
                  style="-fx-background-color: #1e3a5f;">
                <VBox.margin><Insets bottom="16.0"/></VBox.margin>
            </Pane>

            <!-- Adults -->
            <HBox alignment="CENTER_LEFT" spacing="0.0">
                <VBox.margin><Insets bottom="10.0"/></VBox.margin>
                <Label text="Adulti (16+)" styleClass="labelCustom1" HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="8.0">
                    <Button fx:id="btnAdultiMinus" text="−" onAction="#rimuoviAdulto"
                            styleClass="minusButton"/>
                    <Label fx:id="lblAdulti" text="0" styleClass="counter-value"/>
                    <Button fx:id="btnAdultiPlus" text="+" onAction="#aggiungiAdulto"
                            styleClass="plusButton"/>
                </HBox>
            </HBox>

            <!-- Children -->
            <HBox alignment="CENTER_LEFT" spacing="0.0">
                <VBox.margin><Insets bottom="10.0"/></VBox.margin>
                <Label text="Bambini" styleClass="labelCustom1" HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="8.0">
                    <Button fx:id="btnBambiniMinus" text="−" onAction="#rimuoviBambino"
                            styleClass="minusButton"/>
                    <Label fx:id="lblBambini" text="0" styleClass="counter-value"/>
                    <Button fx:id="btnBambiniPlus" text="+" onAction="#aggiungiBambino"
                            styleClass="plusButton"/>
                </HBox>
            </HBox>

            <!-- Baggage -->
            <HBox alignment="CENTER_LEFT" spacing="0.0">
                <VBox.margin><Insets bottom="16.0"/></VBox.margin>
                <Label text="Bagagli" styleClass="labelCustom1" HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="8.0">
                    <Button fx:id="btnBagagliMinus" text="−" onAction="#rimuoviBagaglio"
                            styleClass="minusButton"/>
                    <Label fx:id="lblBagagli" text="0" styleClass="counter-value"/>
                    <Button fx:id="btnBagagliPlus" text="+" onAction="#aggiungiBagaglio"
                            styleClass="plusButton"/>
                </HBox>
            </HBox>

            <!-- Class -->
            <Label text="CLASSE" styleClass="form-label">
                <VBox.margin><Insets bottom="5.0"/></VBox.margin>
            </Label>
            <ComboBox fx:id="cbClasse" prefWidth="212.0" prefHeight="40.0"
                      promptText="Seleziona classe" styleClass="customComboBox">
                <VBox.margin><Insets bottom="20.0"/></VBox.margin>
            </ComboBox>

            <!-- Divider -->
            <Pane prefHeight="1.0" prefWidth="212.0"
                  style="-fx-background-color: #1e3a5f;">
                <VBox.margin><Insets bottom="16.0"/></VBox.margin>
            </Pane>

            <!-- Price -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <VBox.margin><Insets bottom="14.0"/></VBox.margin>
                <Label text="Prezzo:" styleClass="labelCustom1"
                       style="-fx-font-size: 13px;"/>
                <Label fx:id="lblPrezzo" text="€ 0,00" styleClass="price-label"/>
            </HBox>

            <!-- Book button -->
            <Button fx:id="btnPrenota" text="PRENOTA ORA"
                    onAction="#confermaPrenotazione"
                    styleClass="prenotaButton"
                    prefHeight="54.0" prefWidth="212.0">
                <VBox.margin><Insets bottom="12.0"/></VBox.margin>
            </Button>

            <!-- Status label -->
            <Label fx:id="segnala" prefWidth="212.0" wrapText="true"
                   styleClass="error-label" style="-fx-font-size: 12px;"/>

        </VBox>
    </left>

    <!-- ══ TABLE ══ -->
    <center>
        <VBox style="-fx-background-color: #0d1b2a;" BorderPane.alignment="CENTER">

            <!-- Sub-header -->
            <HBox alignment="CENTER_LEFT" spacing="12.0"
                  style="-fx-padding: 16 20 12 20; -fx-border-color: #1e3a5f; -fx-border-width: 0 0 1 0;">
                <Pane prefWidth="3.0" prefHeight="20.0"
                      style="-fx-background-color: #800303; -fx-background-radius: 2;"/>
                <Label text="Treni disponibili"
                       style="-fx-text-fill: #f4e7e7; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Table -->
            <TableView fx:id="tblVoli" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colOrario"       text="Orario"       prefWidth="90.0"/>
                    <TableColumn fx:id="colRitardo"      text="Ritardo"       prefWidth="80.0"/>
                    <TableColumn fx:id="colDestinazione" text="Destinazione"  prefWidth="130.0"/>
                    <TableColumn fx:id="colNVolo"        text="N° Treno"      prefWidth="100.0"/>
                    <TableColumn fx:id="colGate"         text="Binario"       prefWidth="80.0"/>
                    <TableColumn fx:id="colCompagnia"    text="Compagnia"     prefWidth="110.0"/>
                    <TableColumn fx:id="colStato"        text="Stato"         prefWidth="100.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="636.0" prefWidth="880.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="FastRailStation.view.controller.PrenotazioneController">

    <!-- ══ TOP BAR ══ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-background-color: 9597a09597a0; -fx-border-color: #800303; -fx-border-width: 0 0 2 0; -fx-padding: 14 22 14 22;" BorderPane.alignment="CENTER">
            <Button fx:id="btnHome" onAction="#handleBtnHome" styleClass="ghost-button" text="← Home" />
            <Label fx:id="lblOrologio" styleClass="timeLabel" text="00:00:00" />
            <HBox HBox.hgrow="ALWAYS" />
            <Pane prefHeight="22.0" prefWidth="3.0" style="-fx-background-color: #800303; -fx-background-radius: 2;" />
            <Label style="-fx-text-fill: #f4e7e7; -fx-font-size: 20px; -fx-font-weight: bold;" text="Prenotazione" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button fx:id="btnAccedi" onAction="#handleBtnAccedi" styleClass="accediButton" text="Accedi" />
        </HBox>
    </top>

    <!-- ══ SIDEBAR ══ -->
    <left>
        <VBox prefWidth="248.0" spacing="0.0" styleClass="sidebar" BorderPane.alignment="TOP_LEFT">
            <padding><Insets bottom="22.0" left="18.0" right="18.0" top="22.0" /></padding>

            <!-- Search section -->
            <Label styleClass="sidebar-title" text="RICERCA TRENO">
                <VBox.margin><Insets bottom="12.0" /></VBox.margin>
            </Label>
            <Pane prefHeight="1.0" prefWidth="212.0" style="-fx-background-color: #1e3a5f;">
                <VBox.margin><Insets bottom="16.0" /></VBox.margin>
            </Pane>

            <!-- Date -->
            <Label styleClass="form-label" text="DATA PARTENZA">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Label>
            <DatePicker fx:id="dpDataPartenza" prefWidth="212.0" promptText="Data" styleClass="customDatePicker">
                <VBox.margin><Insets bottom="14.0" /></VBox.margin>
            </DatePicker>

            <!-- Destination -->
            <Label styleClass="form-label" text="DESTINAZIONE">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Label>
            <TextField fx:id="txtDestinazione" prefWidth="212.0" promptText="Destinazione" styleClass="customTextField">
                <VBox.margin><Insets bottom="20.0" /></VBox.margin>
            </TextField>

            <!-- Passengers section -->
            <Label styleClass="sidebar-title" text="PASSEGGERI">
                <VBox.margin><Insets bottom="12.0" /></VBox.margin>
            </Label>
            <Pane prefHeight="1.0" prefWidth="212.0" style="-fx-background-color: #1e3a5f;">
                <VBox.margin><Insets bottom="16.0" /></VBox.margin>
            </Pane>

            <!-- Adults -->
            <HBox alignment="CENTER_LEFT" spacing="0.0">
                <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                <Label styleClass="labelCustom1" text="Adulti (16+)" HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="8.0">
                    <Button fx:id="btnAdultiMinus" onAction="#rimuoviAdulto" styleClass="minusButton" text="−" />
                    <Label fx:id="lblAdulti" styleClass="counter-value" text="0" />
                    <Button fx:id="btnAdultiPlus" onAction="#aggiungiAdulto" styleClass="plusButton" text="+" />
                </HBox>
            </HBox>

            <!-- Children -->
            <HBox alignment="CENTER_LEFT" spacing="0.0">
                <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                <Label styleClass="labelCustom1" text="Bambini" HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="8.0">
                    <Button fx:id="btnBambiniMinus" onAction="#rimuoviBambino" styleClass="minusButton" text="−" />
                    <Label fx:id="lblBambini" styleClass="counter-value" text="0" />
                    <Button fx:id="btnBambiniPlus" onAction="#aggiungiBambino" styleClass="plusButton" text="+" />
                </HBox>
            </HBox>

            <!-- Baggage -->
            <HBox alignment="CENTER_LEFT" spacing="0.0">
                <VBox.margin><Insets bottom="16.0" /></VBox.margin>
                <Label styleClass="labelCustom1" text="Bagagli" HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="8.0">
                    <Button fx:id="btnBagagliMinus" onAction="#rimuoviBagaglio" styleClass="minusButton" text="−" />
                    <Label fx:id="lblBagagli" styleClass="counter-value" text="0" />
                    <Button fx:id="btnBagagliPlus" onAction="#aggiungiBagaglio" styleClass="plusButton" text="+" />
                </HBox>
            </HBox>

            <!-- Class -->
            <Label styleClass="form-label" text="CLASSE">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Label>
            <ComboBox fx:id="cbClasse" prefHeight="40.0" prefWidth="212.0" promptText="Seleziona classe" styleClass="customComboBox">
                <VBox.margin><Insets bottom="20.0" /></VBox.margin>
            </ComboBox>

            <!-- Divider -->
            <Pane prefHeight="1.0" prefWidth="212.0" style="-fx-background-color: #1e3a5f;">
                <VBox.margin><Insets bottom="16.0" /></VBox.margin>
            </Pane>

            <!-- Price -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <VBox.margin><Insets bottom="14.0" /></VBox.margin>
                <Label style="-fx-font-size: 13px;" styleClass="labelCustom1" text="Prezzo:" />
                <Label fx:id="lblPrezzo" styleClass="price-label" text="€ 0,00" />
            </HBox>

            <!-- Book button -->
            <Button fx:id="btnPrenota" onAction="#confermaPrenotazione" prefHeight="54.0" prefWidth="212.0" styleClass="prenotaButton" text="PRENOTA ORA">
                <VBox.margin><Insets bottom="12.0" /></VBox.margin>
            </Button>

            <!-- Status label -->
            <Label fx:id="segnala" prefWidth="212.0" style="-fx-font-size: 12px; -fx-text-fill: #831B1BFF;" wrapText="true" />

        </VBox>
    </left>

    <!-- ══ TABLE ══ -->
    <center>
        <VBox style="-fx-background-color: #7b7c81;" BorderPane.alignment="CENTER">

            <!-- Sub-header -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 16 20 12 20; -fx-border-color: #1e3a5f; -fx-border-width: 0 0 1 0;">
                <Pane prefHeight="20.0" prefWidth="3.0" style="-fx-background-color: #800303; -fx-background-radius: 2;" />
                <Label style="-fx-text-fill: #f4e7e7; -fx-font-size: 16px; -fx-font-weight: bold;" text="Treni disponibili" />
            </HBox>

            <!-- Table -->
            <TableView fx:id="tblVoli" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colOrario" prefWidth="90.0" text="Orario" />
                    <TableColumn fx:id="colRitardo" prefWidth="80.0" text="Ritardo" />
                    <TableColumn fx:id="colDestinazione" prefWidth="130.0" text="Destinazione" />
                    <TableColumn fx:id="colNVolo" prefWidth="100.0" text="N° Treno" />
                    <TableColumn fx:id="colGate" prefWidth="80.0" text="Binario" />
                    <TableColumn fx:id="colCompagnia" prefWidth="110.0" text="Compagnia" />
                    <TableColumn fx:id="colStato" prefWidth="100.0" text="Stato" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

</BorderPane>
